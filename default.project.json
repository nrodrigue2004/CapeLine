{
  "name": "Capeline",
  "servePort": 34874,
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "LoadingScreen": { "$path": "src/first/LoadingScreen.client.luau" }
    },
    "ReplicatedStorage": {
      "Config": { "$path": "src/config" },
      "Shared": { "$path": "src/shared" },
      "Art": {
        "$className": "Folder",
        "Robots": { "$path": "art/models/Robots.rbxm" },
        "Hero": { "$path": "art/models/Hero.rbxm" }
      }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "MaterialService": {
      "$className": "MaterialService",
      "KitAsphalt": {
        "$path": "src/materials/KitAsphalt.model.json"
      },
      "KitBrick": {
        "$path": "src/materials/KitBrick.model.json"
      },
      "KitCobble": {
        "$path": "src/materials/KitCobble.model.json"
      },
      "KitContainer": {
        "$path": "src/materials/KitContainer.model.json"
      },
      "KitCurtain": {
        "$path": "src/materials/KitCurtain.model.json"
      },
      "KitDeco": {
        "$path": "src/materials/KitDeco.model.json"
      },
      "KitDockBrick": {
        "$path": "src/materials/KitDockBrick.model.json"
      },
      "KitFlagstone": {
        "$path": "src/materials/KitFlagstone.model.json"
      },
      "KitOffice": {
        "$path": "src/materials/KitOffice.model.json"
      },
      "KitOldBrick": {
        "$path": "src/materials/KitOldBrick.model.json"
      },
      "KitPanel": {
        "$path": "src/materials/KitPanel.model.json"
      },
      "KitPaving": {
        "$path": "src/materials/KitPaving.model.json"
      },
      "KitPlaster": {
        "$path": "src/materials/KitPlaster.model.json"
      },
      "KitPrism": {
        "$path": "src/materials/KitPrism.model.json"
      },
      "KitQuay": {
        "$path": "src/materials/KitQuay.model.json"
      },
      "KitRibbon": {
        "$path": "src/materials/KitRibbon.model.json"
      },
      "KitRoofTile": {
        "$path": "src/materials/KitRoofTile.model.json"
      },
      "KitSiding": {
        "$path": "src/materials/KitSiding.model.json"
      },
      "KitStone": {
        "$path": "src/materials/KitStone.model.json"
      },
      "KitTerrazzo": {
        "$path": "src/materials/KitTerrazzo.model.json"
      },
      "KitTimber": {
        "$path": "src/materials/KitTimber.model.json"
      },
      "KitWarehouse": {
        "$path": "src/materials/KitWarehouse.model.json"
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "CameraMaxZoomDistance": 60
      },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      },
      "StarterCharacterScripts": {
        "Health": { "$path": "src/character/Health.server.luau" }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingTargetRadius": 600,
        "StreamingMinRadius": 256,
        "StreamOutBehavior": "Opportunistic"
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 16.8,
        "Brightness": 2.4,
        "GlobalShadows": true,
        "Technology": "Future",
        "ShadowSoftness": 0.25,
        "OutdoorAmbient": [0.52, 0.5, 0.56],
        "Ambient": [0.2, 0.2, 0.26],
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.3,
          "Offset": 0.15,
          "Color": [0.92, 0.78, 0.66],
          "Decay": [0.55, 0.5, 0.7],
          "Glare": 0.2,
          "Haze": 1.2
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": { "Intensity": 0.5, "Size": 24, "Threshold": 1.3 }
      },
      "Grade": {
        "$className": "ColorCorrectionEffect",
        "$properties": { "Saturation": 0.18, "Contrast": 0.08, "Brightness": 0.02 }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": { "Intensity": 0.06, "Spread": 0.6 }
      }
    }
  }
}

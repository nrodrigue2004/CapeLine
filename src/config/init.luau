local Config: { [string]: any } = {}
for _, name in NAMES do
	if script then
		Config[name] = require((script :: any):WaitForChild(name))
	else
		Config[name] = (require :: any)("./" .. name)
	end
end

-- The weapons' moves join the ability table (list and byNum, never order, so loadouts and the 136 powers
-- stay as they are) and CombatService casts them like any power (Config.Weapons.skills)
do
	local A, W = Config.Abilities, Config.Weapons
	for weaponId, rows in W.skills do
		for key, src in rows do
			local row = table.clone(src)
			row.num = W.numBase + weaponId * 5 + (key - 1)
			row.id = "W" .. weaponId .. (if key == 1 then "M1" else W.keys[key - 1])
			row.set = "Weapon"
			row.slot = if key == 1 then "basic" else "skill"
			row.weapon = weaponId
			row.weaponKey = if key == 1 then "M1" else W.keys[key - 1]
			row.pts = 0
			A.list[row.id] = row
			A.byNum[row.num] = row
		end
	end
end

-- Robot names in activity text come from ONE place: a "{Kind}" token in a text string is the robot's
-- Config.Enemies[Kind].name, so renaming a robot is one line in Enemies (nate's lore, 2026-11-17).
local NAMED_TEXT = { "Incidents", "Contracts", "Events", "Deep", "Boss", "World" }
do
	local E = Config.Enemies
	local function fill(t: { [any]: any }, seen: { [any]: boolean })
		seen[t] = true
		for k, v in t do
			if type(v) == "string" and string.find(v, "{", 1, true) then
				t[k] = string.gsub(v, "{(%w+)}", function(kind: string): string
					local e = E[kind]
					return if type(e) == "table" and e.name then e.name else "{" .. kind .. "}"
				end)
			elseif type(v) == "table" and not seen[v] then
				fill(v, seen)
			end
		end
	end
	for _, name in NAMED_TEXT do
		fill(Config[name], {})
	end
end

return Config

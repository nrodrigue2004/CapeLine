--!strict
-- VehicleKit: the hub's 40 cars, trams and trucks (Shared.Vehicles) dressed in art/blender/vehicles.py's meshes,
-- imported by nate as ReplicatedStorage.Art.Vehicles (Config.VehicleArt, generated by the same script, gives each
-- mesh's size, centre, colour and material). Pure, so Lune checks it.
-- * parts(v): the plain parts VehicleService builds for a vehicle (its body first, the root its pose moves): the
--   look before the import, and after it the hidden boxes that keep the vehicle's collision, flips, throws and
--   queries exactly as before.
-- * look(v): the vehicle's look: three Downtown cars picked by id (CarSedan, CarHatch, CarTaxi), Old Town's
--   CarBubble, the Tram and the Docks' DockTruck. place(Config, v) is its Shared.SetPieceKit placement at the
--   vehicle's own root, its body painted the vehicle's colour (PAINT; the taxi stays taxi yellow).
-- * A look is drawn only when every one of its meshes is imported (SetPieceKit.ready), so a half import keeps the
--   parts; check(Config, v) keeps every look over its parts (tests).
-- * ESCORT: the side quest escort's motorcade boxes (SideQuestService), which SetPieceKit.TRUCKS' looks stand over;
--   checkEscort(Config, look) holds each truck look to them.

local SetPieceKit = if script then require(script.Parent.SetPieceKit) else (require :: any)("./SetPieceKit")

local VehicleKit = {}

export type Part = {
	size: { number },
	at: { number }, -- its middle from the vehicle's root (the ground under the vehicle's middle; nose to -z)
	tone: string, -- body (the vehicle's colour), glass, dark
	wheel: boolean?, -- a cylinder along x
}

-- The paint a vehicle's colour key gives its look's body: the city palette's container and roof colours made
-- bright comic car paints (any other key paints the palette colour itself)
VehicleKit.PAINT = {
	containerA = { 226, 64, 52 }, -- red
	containerB = { 52, 128, 220 }, -- blue
	containerC = { 250, 196, 44 }, -- yellow
	containerD = { 80, 184, 96 }, -- green
	white = { 244, 244, 240 },
	roofBlue = { 40, 180, 190 }, -- teal
} :: { [string]: { number } }

-- The mesh each look paints (the taxi has none: it is always taxi yellow)
VehicleKit.BODY = {
	CarHatch = "CarHatchBody",
	CarSedan = "CarSedanBody",
	CarBubble = "CarBubbleBody",
	Tram = "TramBody",
	DockTruck = "DockTruckBody",
} :: { [string]: string }

-- Downtown's cars by id: one in five a taxi
VehicleKit.DOWNTOWN = { "CarSedan", "CarHatch", "CarTaxi", "CarHatch", "CarSedan" }

-- The escort's motorcade boxes (SideQuestService: the body and the cab, nose to -z)
VehicleKit.ESCORT = {
	{ size = { 7, 4, 14 }, at = { 0, 2.5, 0 }, tone = "dark" },
	{ size = { 6.6, 2.4, 6 }, at = { 0, 5.6, -2 }, tone = "cab" },
} :: { Part }

function VehicleKit.parts(v: any): { Part }
	local sx, sy, sz = v.sx, v.sy, v.sz
	local out: { Part } = { { size = { sx, sy * 0.55, sz }, at = { 0, sy * 0.275 + 1, 0 }, tone = "body" } }
	if v.kind == "car" then
		table.insert(
			out,
			{ size = { sx * 0.9, sy * 0.4, sz * 0.5 }, at = { 0, sy * 0.75 + 1, -0.5 }, tone = "glass" }
		)
	elseif v.kind == "truck" then
		table.insert(
			out,
			{ size = { sx, sy * 0.6, sz * 0.3 }, at = { 0, sy * 0.6 + 1, -sz * 0.35 }, tone = "glass" }
		)
		table.insert(
			out,
			{ size = { sx * 0.95, sy * 0.8, sz * 0.6 }, at = { 0, sy * 0.6 + 1, sz * 0.18 }, tone = "body" }
		)
	else
		table.insert(
			out,
			{ size = { sx * 0.98, sy * 0.35, sz * 0.96 }, at = { 0, sy * 0.72 + 1, 0 }, tone = "glass" }
		)
		table.insert(out, { size = { sx * 0.6, 0.6, sz * 0.9 }, at = { 0, sy + 1.3, 0 }, tone = "dark" })
	end
	local wheel = math.min(2.6, sy * 0.45)
	for _, s in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do
		table.insert(out, {
			size = { 1.2, wheel, wheel },
			at = { s[1] * (sx / 2 - 0.4), wheel / 2, s[2] * (sz / 2 - wheel) },
			tone = "dark",
			wheel = true,
		})
	end
	return out
end

function VehicleKit.look(v: any): string
	if v.kind == "tram" then
		return "Tram"
	elseif v.kind == "truck" then
		return "DockTruck"
	elseif v.district == "OldTown" then
		return "CarBubble"
	end
	local d = VehicleKit.DOWNTOWN
	return d[(v.id * 3) % #d + 1]
end

-- The look's placement at the vehicle's root (its meshes' offsets are from the root, before the root's turn)
function VehicleKit.place(Config: any, v: any): SetPieceKit.Place
	local look = VehicleKit.look(v)
	local body = VehicleKit.BODY[look]
	local tint = nil
	if body then
		local c = VehicleKit.PAINT[v.color] or (Config.City and Config.City.palette[v.color])
		if c then
			tint = { [body] = c }
		end
	end
	return { look = look, x = 0, y = 0, z = 0, ry = 0, tint = tint }
end

-- The box round a list of parts: lo, hi ({ x, y, z } each)
local function around(parts: { Part }): ({ number }, { number })
	local lo = { math.huge, math.huge, math.huge }
	local hi = { -math.huge, -math.huge, -math.huge }
	for _, p in parts do
		for k = 1, 3 do
			lo[k] = math.min(lo[k], p.at[k] - p.size[k] / 2)
			hi[k] = math.max(hi[k], p.at[k] + p.size[k] / 2)
		end
	end
	return lo, hi
end

-- Problems with a look over these parts (empty when fine): a known look whose meshes cover at least `cover` of
-- the parts' footprint, never reach more than `side` studs past them across or along, stand on the ground (never
-- under it) and top out within `under` below and `over` above the parts' top
local function fits(
	Config: any,
	look: string,
	parts: { Part },
	side: number,
	cover: number,
	under: number,
	over: number
): { string }
	local bad = {}
	if SetPieceKit.fit(Config, look) == nil then
		return { look .. ": unknown look" }
	end
	local blo, bhi = around(parts)
	local mlo, mhi = SetPieceKit.bounds(Config, { look = look, x = 0, y = 0, z = 0 })
	for _, k in { 1, 3 } do
		if mlo[k] < blo[k] - side or mhi[k] > bhi[k] + side then
			table.insert(bad, string.format("%s: the meshes reach past the parts (axis %d)", look, k))
		end
		if mhi[k] - mlo[k] < (bhi[k] - blo[k]) * cover then
			table.insert(
				bad,
				string.format("%s: the meshes cover too little of the parts (axis %d)", look, k)
			)
		end
	end
	if mlo[2] < -0.05 or mlo[2] > 0.3 then
		table.insert(bad, look .. ": the meshes do not stand on the ground")
	end
	if mhi[2] < bhi[2] - under or mhi[2] > bhi[2] + over then
		table.insert(
			bad,
			string.format("%s: the top (%.2f) is off the parts' top (%.2f)", look, mhi[2], bhi[2])
		)
	end
	return bad
end

-- A hub vehicle's look over its parts: the same footprint (half a stud each way), the same height (a roof sign or
-- a pantograph at most a stud over), so a hero lands on the hidden boxes where the meshes are
function VehicleKit.check(Config: any, v: any): { string }
	return fits(Config, VehicleKit.look(v), VehicleKit.parts(v), 0.5, 0.9, 1.2, 1.0)
end

-- An escort's look over the motorcade boxes (they never collide: SiteKit props): 1.5 studs each way (an awning,
-- the mirrors), and up to 7 studs over for a roof sign, dish or giant cone
function VehicleKit.checkEscort(Config: any, look: string): { string }
	return fits(Config, look, VehicleKit.ESCORT, 1.5, 0.9, 1.5, 7)
end

return VehicleKit

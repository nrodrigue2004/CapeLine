--!strict
-- CraterArtKit: the Crater's blasted Crane lab dressed in art/blender/crater.py's meshes (gap-wrecks, 2026-11-19;
-- imported as ReplicatedStorage.Art.Crater, each look's frame and meshes in Config.CraterArt, generated by the same
-- script from the game's own boxes). Pure, so Lune checks it. The same rules as the Deep's (Shared.DeepArtKit, whose
-- helpers this reuses over Config.CraterArt):
-- * WorldGen.craterRuins tags every box a look stands in for with `art` = the look's name and lists the looks'
--   placements (Landmark.art): each placement is the box round the boxes it covers, in the look's own turn (cover).
-- * A look is drawn only once every one of its meshes is found (readyLooks); its boxes are then hidden but kept
--   exactly as they were (they still collide, take queries and stand where they stood); the meshes never collide.
--   Nothing found: every box shows as today (the Studio-friendly fallback).
-- * bits(Config, cx, fy, cz, preset): the loose lab debris each device scatters over the floor by its preset
--   (Config.Presets <preset>.ruins: none on phones); ghosts, never near the open middle or the walls' boxes.

local DeepArtKit = if script then require(script.Parent.DeepArtKit) else (require :: any)("./DeepArtKit")
local Rng = if script then require(script.Parent.Rng) else (require :: any)("./Rng")

local CraterArtKit = {}

export type Place = {
	look: string,
	cx: number,
	cy: number,
	cz: number,
	sx: number,
	sy: number,
	sz: number,
	ry: number?,
}

-- How far a mesh may reach past its placement (studs): rebar out of a broken end, cables off a tank, a husk's arms.
-- They never collide; Config.World.crater keeps the middle open and everything under its maxTop (check).
CraterArtKit.SLACK = 3.2

-- DeepArtKit reads Config.DeepArt; the Crater's looks are the same shape in Config.CraterArt
local function view(Config: any): any
	return { DeepArt = Config.CraterArt or {}, City = Config.City }
end

function CraterArtKit.fit(Config: any, look: string): any?
	return DeepArtKit.fit(view(Config), look)
end

function CraterArtKit.ready(Config: any, look: string, has: (string) -> boolean): boolean
	return DeepArtKit.ready(view(Config), look, has)
end

function CraterArtKit.readyLooks(Config: any, has: (string) -> boolean): { [string]: boolean }
	return DeepArtKit.readyLooks(view(Config), has)
end

CraterArtKit.hides = DeepArtKit.hides
CraterArtKit.corners = DeepArtKit.corners
CraterArtKit.inside = DeepArtKit.inside

function CraterArtKit.meshes(Config: any, place: any): { DeepArtKit.Mesh }
	return DeepArtKit.meshes(view(Config), place)
end

function CraterArtKit.budget(Config: any, art: { Place }): (number, number)
	return DeepArtKit.budget(view(Config), { art = art })
end

-- Problems (empty when fine): every placement's look known and fitted, never stretched (each look is built for its
-- own boxes), every tagged box inside its look's placement, the meshes inside their placement (`slack` studs), and
-- every look in Config.CraterArt placed (the scatter's bits are placed by `bits`, not the layout)
function CraterArtKit.check(Config: any, boxes: { any }, art: { Place }, slack: number?): { string }
	local bad = DeepArtKit.check(view(Config), { boxes = boxes, art = art }, slack or CraterArtKit.SLACK)
	local placed: { [string]: boolean } = {}
	for i, p in art do
		placed[p.look] = true
		local kx, ky, kz = DeepArtKit.scale(view(Config), p)
		if math.abs(kx - 1) > 0.02 or math.abs(ky - 1) > 0.02 or math.abs(kz - 1) > 0.02 then
			table.insert(
				bad,
				string.format("place %d %s: not built for its boxes (%.2f %.2f %.2f)", i, p.look, kx, ky, kz)
			)
		end
	end
	for look in Config.CraterArt or {} do
		if not placed[look] and not Config.World.crater.art.bits[look] then
			table.insert(bad, look .. ": in Config.CraterArt but never placed")
		end
	end
	return bad
end

-- The placement round `list` (boxes it stands in for), turned ry degrees about up with its middle at (cx, cz) on
-- the ground plan: the boxes' corners in its own axes, their bounds grown by `pad` studs. Tags each box with `look`.
function CraterArtKit.cover(
	look: string,
	list: { any },
	cx: number,
	cz: number,
	ry: number,
	pad: number
): Place
	local a = math.rad(ry)
	local c, s = math.cos(a), math.sin(a)
	local lo = { math.huge, math.huge, math.huge }
	local hi = { -math.huge, -math.huge, -math.huge }
	for _, b in list do
		b.art = look
		for _, q in DeepArtKit.corners(b) do
			local dx, dz = q[1] - cx, q[3] - cz
			-- into the placement's axes (Roblox's turn about up: world = (lx c + lz s, -lx s + lz c))
			local l = { dx * c - dz * s, q[2], dx * s + dz * c }
			for k = 1, 3 do
				lo[k] = math.min(lo[k], l[k])
				hi[k] = math.max(hi[k], l[k])
			end
		end
	end
	for k = 1, 3 do
		lo[k] -= pad
		hi[k] += pad
	end
	-- the middle back in world studs
	local mx, mz = (lo[1] + hi[1]) / 2, (lo[3] + hi[3]) / 2
	local function r3(v: number): number
		return math.floor(v * 1000 + 0.5) / 1000
	end
	return {
		look = look,
		cx = r3(cx + mx * c + mz * s),
		cy = r3((lo[2] + hi[2]) / 2),
		cz = r3(cz - mx * s + mz * c),
		sx = r3(hi[1] - lo[1]),
		sy = r3(hi[2] - lo[2]),
		sz = r3(hi[3] - lo[3]),
		ry = ry,
	}
end

export type Bit = { look: string, x: number, z: number, ry: number }

-- The loose debris this preset scatters on the Crater's floor (seeded, so every device of a preset lays the same):
-- `n` bits by Config.Presets <preset>.ruins, each a look from Config.World.crater.art.bits (weights), on a ring
-- from the open middle out to the bowl's edge, clear of the placements (pad studs) so nothing pokes through a wall
function CraterArtKit.bits(Config: any, cx: number, cz: number, art: { Place }, preset: string): { Bit }
	local C = Config.World.crater
	local A = C.art
	local pr = Config.Presets[preset] or Config.Presets.low
	local n = (pr.ruins and pr.ruins.bits) or 0
	local out: { Bit } = {}
	if n <= 0 then
		return out
	end
	local looks = {}
	local total = 0
	for look, w in A.bits do
		table.insert(looks, { look = look, w = w })
		total += w
	end
	table.sort(looks, function(a, b)
		return a.look < b.look
	end)
	local rng = Rng.new(A.seed)
	local tries = 0
	while #out < n and tries < n * 30 do
		tries += 1
		local ang = rng:next() * math.pi * 2
		local d = A.ring[1] + rng:next() * (A.ring[2] - A.ring[1])
		local x, z = cx + math.cos(ang) * d, cz + math.sin(ang) * d
		-- (never on the lab's foundation slab: the walls and tanks stand there, the bits lie on the bowl's floor)
		local f = C.foundation
		local clear = math.abs(x - cx) > f.w / 2 + A.pad or math.abs(z - cz) > f.d / 2 + A.pad
		for _, p in art do
			if DeepArtKit.inside(p, x, p.cy, z, A.pad) then
				clear = false
				break
			end
		end
		for _, b in out do
			if (b.x - x) ^ 2 + (b.z - z) ^ 2 < A.apart * A.apart then
				clear = false
				break
			end
		end
		if not clear then
			continue
		end
		local pick = rng:next() * total
		local look = looks[#looks].look
		for _, l in looks do
			pick -= l.w
			if pick <= 0 then
				look = l.look
				break
			end
		end
		table.insert(out, { look = look, x = x, z = z, ry = math.floor(rng:next() * 360) })
	end
	return out
end

return CraterArtKit

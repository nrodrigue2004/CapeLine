--!strict
-- NewsArtKit: the in-city news's art (gap-news, 2026-11-19). Pure, so Lune checks it.
-- * The big screens' Blender looks (art/blender/screens.py's meshes, uploaded and pulled into
--   ReplicatedStorage.Art.News; each mesh's size, centre, colour and material is Config.ScreenArt, generated by the
--   same script). Each look dresses one screen kind of Shared.NewsPlan.screens round its screen part (the frame
--   is the screen part's centre, front at -z): the plaza's on its own pillars, a Downtown tower's and Uptown's
--   landmark billboard. A look is drawn only when every one of its meshes is found (ready), so a half import never
--   shows half a look; NewsService then hides the plain frame and legs it stands for. The screen part itself stays
--   as it is (the SurfaceGui draws on it, a collapse turns it dark) and the meshes never collide, take queries or
--   touches, like today's parts. Nothing imported: today's parts show (the fallback).
-- * The HUD's art (Config.NewsArt, art/news/post.py): each world boss's name card portrait, the name card's plate,
--   the corner TV's case and the channel's mark. An id of 0 answers nil and the UI keeps today's frames.

local NewsArtKit = {}

export type Mesh = {
	name: string,
	size: { number },
	offset: { number },
	color: { number },
	mat: string,
	alpha: number,
	maps: boolean,
}

export type Cell = { image: string, offset: { number }, size: { number } }

-- screen kind -> its look, and how far its meshes may reach past the screen's box (studs: x, up, z each way; the
-- plaza look stands on its own pillars down to the plaza, the others stay off the wall 1 stud behind)
NewsArtKit.LOOKS = {
	plaza = { look = "PlazaScreen", reach = { 2, 14.2, 2.8 } },
	downtown = { look = "TowerScreen", reach = { 1.8, 6.7, 3.4 } },
	uptown = { look = "UptownScreen", reach = { 2.8, 9.4, 5.6 } },
} :: { [string]: { look: string, reach: { number } } }

-- the wall behind a tower's or the landmark's screen, from the screen's centre (NewsPlan.screens: half + 1)
NewsArtKit.WALL = 1

-- A screen kind's screen size { w, h } (Config.Cinema.news.screens)
function NewsArtKit.screenSize(Config: any, kind: string): { number }?
	local S = Config.Cinema.news.screens
	if kind == "plaza" then
		return S.plaza.size
	elseif kind == "downtown" then
		return S.size
	elseif kind == "uptown" then
		return S.uptown.size
	end
	return nil
end

-- A look's fit table (mesh name -> size, offset, colour, material), or nil
function NewsArtKit.fit(Config: any, look: string): { [string]: any }?
	local a = Config.ScreenArt and Config.ScreenArt[look]
	return if type(a) == "table" then a else nil
end

-- The look a screen kind wears, or nil
function NewsArtKit.lookFor(kind: string): string?
	local row = NewsArtKit.LOOKS[kind]
	return row and row.look
end

-- Is every mesh of this look found?
function NewsArtKit.ready(Config: any, look: string, has: (string) -> boolean): boolean
	local fit = NewsArtKit.fit(Config, look)
	if fit == nil or next(fit) == nil then
		return false
	end
	for name in fit do
		if not has(name) then
			return false
		end
	end
	return true
end

-- A look's meshes, sorted by name (offsets from the screen part's centre)
function NewsArtKit.meshes(Config: any, look: string): { Mesh }
	local out: { Mesh } = {}
	for name, f in NewsArtKit.fit(Config, look) or {} do
		table.insert(out, {
			name = name,
			size = f.size,
			offset = f.offset,
			color = f.color,
			mat = f.mat or "SmoothPlastic",
			alpha = f.alpha or 0,
			maps = f.maps == true,
		})
	end
	table.sort(out, function(a, b)
		return a.name < b.name
	end)
	return out
end

-- The box round a look's meshes, in the screen part's studs: lo, hi
function NewsArtKit.bounds(Config: any, look: string): ({ number }, { number })
	local lo = { math.huge, math.huge, math.huge }
	local hi = { -math.huge, -math.huge, -math.huge }
	for _, m in NewsArtKit.meshes(Config, look) do
		for k = 1, 3 do
			lo[k] = math.min(lo[k], m.offset[k] - m.size[k] / 2)
			hi[k] = math.max(hi[k], m.offset[k] + m.size[k] / 2)
		end
	end
	return lo, hi
end

-- Problems (empty when fine): every look fitted, within its screen's box plus its reach, the wall-hung looks never
-- reaching into the wall, the plaza look standing on the plaza and leaving the screen's face clear
function NewsArtKit.check(Config: any): { string }
	local bad = {}
	for kind, row in NewsArtKit.LOOKS do
		local size = NewsArtKit.screenSize(Config, kind)
		if not size then
			table.insert(bad, kind .. ": no screen size")
			continue
		end
		if NewsArtKit.fit(Config, row.look) == nil then
			table.insert(bad, row.look .. ": no fit table")
			continue
		end
		local lo, hi = NewsArtKit.bounds(Config, row.look)
		local box = { size[1] / 2, size[2] / 2, 0.3 }
		for k = 1, 3 do
			if lo[k] < -box[k] - row.reach[k] - 0.05 or hi[k] > box[k] + row.reach[k] + 0.05 then
				table.insert(
					bad,
					string.format(
						"%s: reaches past its screen (axis %d: %.2f..%.2f)",
						row.look,
						k,
						lo[k],
						hi[k]
					)
				)
			end
		end
		if kind ~= "plaza" and hi[3] > NewsArtKit.WALL + 0.01 then
			table.insert(bad, string.format("%s: reaches into the wall (%.2f)", row.look, hi[3]))
		end
		if kind == "plaza" then
			local down = Config.Cinema.news.screens.plaza.height
			if lo[2] < -down - 0.05 or lo[2] > -down + 0.5 then
				table.insert(bad, string.format("%s: does not stand on the plaza (%.2f)", row.look, lo[2]))
			end
		end
		-- nothing sits in front of the screen's face inside its box (the news must read)
		for _, m in NewsArtKit.meshes(Config, row.look) do
			local front = m.offset[3] - m.size[3] / 2
			local inX = math.abs(m.offset[1]) + m.size[1] / 2 < size[1] / 2 - 0.5
			local inY = math.abs(m.offset[2]) + m.size[2] / 2 < size[2] / 2 - 0.5
			if front < -0.3 and inX and inY then
				table.insert(bad, m.name .. ": covers the screen's face")
			end
		end
	end
	return bad
end

---------------------------------------------------------------------------
-- The HUD's images (Config.NewsArt)
---------------------------------------------------------------------------

local function asset(id: any): string?
	if type(id) ~= "number" or id <= 0 then
		return nil
	end
	return "rbxassetid://" .. id
end

-- A world boss's name card portrait (its sheet and cell), or nil (not uploaded or no portrait)
function NewsArtKit.portrait(Config: any, bossId: string): Cell?
	local A = Config.NewsArt
	local at = A and A.cards.at[bossId]
	-- bosses-3: a sheet holds 4 cells; at[3] names the sheet (1 when left out)
	local sheet = if at and at[3] and A.cards.sheets then A.cards.sheets[at[3]] else A and A.cards.sheet
	local image = A and asset(sheet)
	if not at or not image then
		return nil
	end
	local c = A.cards.cell
	return { image = image, offset = { at[1] * c, at[2] * c }, size = { c, c } }
end

-- The name card's plate: image, its size and the 9-slice margins { left, top, right, bottom }, or nil
function NewsArtKit.plate(Config: any): (string?, { number }?, { number }?)
	local P = Config.NewsArt and Config.NewsArt.plate
	local image = P and asset(P.id)
	if not image then
		return nil, nil, nil
	end
	return image, P.size, P.slice
end

-- The corner TV's case: image, its size and its screen window as shares of the case { x, y, w, h }, or nil
function NewsArtKit.tv(Config: any): (string?, { number }?, { number }?)
	local T = Config.NewsArt and Config.NewsArt.tv
	local image = T and asset(T.id)
	if not image then
		return nil, nil, nil
	end
	local s, w, h = T.screen, T.size[1], T.size[2]
	return image, T.size, { s[1] / w, s[2] / h, (s[3] - s[1]) / w, (s[4] - s[2]) / h }
end

-- The news channel's mark, or nil
function NewsArtKit.ident(Config: any): string?
	local I = Config.NewsArt and Config.NewsArt.ident
	return I and asset(I.id)
end

return NewsArtKit

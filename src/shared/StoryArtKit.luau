--!strict
-- StoryArtKit: the story's props and the Echo Drone in art/blender/story.py's meshes (gap-story, 2026-11-19; imported
-- as ReplicatedStorage.Art.Story, each look's frame and meshes in Config.StoryArt, generated by the same script).
-- Pure, so Lune checks it.
-- * BOXES: the plain parts MissionService builds for a break target and the runaway train (it reads them from here,
--   so the numbers are one; a test holds them to what they were). They never collide (SiteKit.part); every hit is
--   the combat target's lift and radius in MissionService, which no look changes.
-- * lookFor(st): which look dresses a break step's target: the train, the relays, the stage screens, the cash van
--   (a step's own `look` first), else the Crane shard crate.
-- * ready(Config, look, has): every mesh of the look found, so a half import never shows half a look; not ready:
--   today's parts show (the fallback). meshes(Config, look): its meshes (size, centre from the frame's middle).
-- * The trap (a person pinned under a girder at a "people" hold ring): the girder lifts about GIRDER_LOW as the ring
--   is held (lift), then tips off once the person is free. The person is Roblox's own body (NpcRig.person: a catalog
--   face and hair), never drawn here.
-- * The Echo Drone's motion (bob, blink) is a pure function of time and its owner's seed: the same on every device.
-- * check(Config): every look known, built on its boxes, its meshes inside the frame (with REACH to spare), Neon and
--   moving meshes present.

local StoryArtKit = {}

export type Mesh = {
	name: string,
	size: { number },
	offset: { number },
	color: { number },
	mat: string,
	alpha: number,
	maps: boolean,
}

export type Box = { size: { number }, at: { number }, color: { number }, neon: boolean? }

-- The plain parts (from the model's foot, studs) MissionService builds today
StoryArtKit.BOXES = {
	train = {
		{ size = { 10, 9, 26 }, at = { 0, 4.5, 0 }, color = { 220, 200, 70 } },
		{ size = { 10.4, 2, 26.4 }, at = { 0, 7, 0 }, color = { 60, 60, 70 } },
	},
	crate = {
		{ size = { 5, 4, 5 }, at = { 0, 2, 0 }, color = { 120, 90, 200 } },
		{ size = { 1.5, 3, 1.5 }, at = { 0, 5, 0 }, color = { 160, 230, 255 }, neon = true },
	},
} :: { [string]: { Box } }

-- look -> the boxes it stands in for, how far its meshes may reach past its frame (studs x, up, z each way), and
-- the meshes the device moves or lights on its own
StoryArtKit.LOOKS = {
	StoryTrain = { boxes = "train", reach = { 0.2, 0.2, 0.2 } },
	StoryCrate = { boxes = "crate", reach = { 0.2, 0.6, 0.2 } },
	StoryRelay = { boxes = "crate", reach = { 0.2, 1.6, 0.2 } },
	StoryScreen = { boxes = "crate", reach = { 1.3, 0.6, 0.2 } },
	StoryVan = { boxes = "crate", reach = { 0.6, 0.2, 2.0 } },
	StoryTrap = { reach = { 0.3, 0.3, 0.3 }, moves = "StoryTrapGirder", sink = 0.55 },
	StoryBeacon = { reach = { 0.1, 0.2, 0.1 }, moves = "StoryBeaconRings" },
	EchoDrone = { reach = { 0.1, 0.1, 0.1 }, moves = "EchoDroneEye" },
} :: { [string]: { boxes: string?, reach: { number }, moves: string?, sink: number? } }

-- The girder's low end on the ground (the pivot it lifts about) and its high end, from the trap's foot (story.py)
StoryArtKit.GIRDER_LOW = { -4.2, 0.62, 0 }
StoryArtKit.GIRDER_HIGH = { 3.4, 4.6, 0 }
StoryArtKit.LIFT = 16 -- degrees the girder lifts by the time the ring is held
StoryArtKit.TIP = 70 -- degrees it tips over backward once the person is free
-- the trapped person: sitting under the girder's high part, from the trap's foot, and facing the front (-z)
StoryArtKit.PERSON = { 1.6, 0, 0.6 }

-- The Echo Drone (lore: the villain's reprogrammed twin core) hovers at its owner's shoulder
StoryArtKit.DRONE = {
	at = { 2.6, 2.4, 1.2 }, -- from the owner's root, its own studs
	bob = 0.35, -- studs up and down
	bobRate = 2, -- radians a second
	follow = 8, -- how fast it catches up (a second's share, eased)
	blinkEvery = { 2.6, 5.2 }, -- seconds between blinks
	blinkFor = 0.14, -- a blink's seconds
	blinkMin = 0.12, -- the eye's height share at the blink's middle
	lookNear = 28, -- it turns its eye to the nearest other hero within this many studs, else the way its owner looks
	turn = 6, -- how fast it turns (a second's share, eased)
}

local function list(x: any): any
	return x
end

-- Which look dresses a break step's target
function StoryArtKit.lookFor(st: any): string
	if type(st) ~= "table" then
		return "StoryCrate"
	end
	if type(st.look) == "string" then
		return st.look
	end
	if st.train then
		return "StoryTrain"
	elseif st.list == "relays" then
		return "StoryRelay"
	elseif st.list == "screens" then
		return "StoryScreen"
	elseif st.at == "van" then
		return "StoryVan"
	end
	return "StoryCrate"
end

-- A look's fit table ({ frame, meshes }), or nil
function StoryArtKit.fit(Config: any, look: string): any?
	local a = Config.StoryArt and Config.StoryArt[look]
	return if type(a) == "table" and type(a.meshes) == "table" then a else nil
end

function StoryArtKit.ready(Config: any, look: string, has: (string) -> boolean): boolean
	local fit = StoryArtKit.fit(Config, look)
	if fit == nil or next(fit.meshes) == nil then
		return false
	end
	for name in fit.meshes do
		if not has(name) then
			return false
		end
	end
	return true
end

-- A look's meshes, sorted by name (offsets from its frame's middle)
function StoryArtKit.meshes(Config: any, look: string): { Mesh }
	local out: { Mesh } = {}
	local fit = StoryArtKit.fit(Config, look)
	if fit == nil then
		return out
	end
	for name, m in fit.meshes do
		table.insert(out, {
			name = name,
			size = list(m.size),
			offset = list(m.offset),
			color = list(m.color),
			mat = m.mat or "SmoothPlastic",
			alpha = m.alpha or 0,
			maps = m.maps == true,
		})
	end
	table.sort(out, function(a, b)
		return a.name < b.name
	end)
	return out
end

-- A look's frame middle over its foot (studs up)
function StoryArtKit.middle(Config: any, look: string): number
	local fit = StoryArtKit.fit(Config, look)
	return if fit then fit.frame[2] / 2 else 0
end

-- The boxes' union (size and middle from the foot)
function StoryArtKit.union(boxes: { Box }): ({ number }, { number })
	local lo, hi = { math.huge, math.huge, math.huge }, { -math.huge, -math.huge, -math.huge }
	for _, b in boxes do
		for k = 1, 3 do
			lo[k] = math.min(lo[k], b.at[k] - b.size[k] / 2)
			hi[k] = math.max(hi[k], b.at[k] + b.size[k] / 2)
		end
	end
	return { hi[1] - lo[1], hi[2] - lo[2], hi[3] - lo[3] }, {
		(lo[1] + hi[1]) / 2,
		(lo[2] + hi[2]) / 2,
		(lo[3] + hi[3]) / 2,
	}
end

-- The girder's lift (degrees about its low end) at a hold ring's share held (0..1)
function StoryArtKit.lift(share: number): number
	local s = math.clamp(share, 0, 1)
	return StoryArtKit.LIFT * (1 - (1 - s) * (1 - s))
end

-- The drone's bob (studs) at time t for its owner's seed
function StoryArtKit.bob(t: number, seed: number): number
	local D = StoryArtKit.DRONE
	return math.sin(t * D.bobRate + (seed % 7)) * D.bob
end

-- The drone's eye height share (1 open, blinkMin at a blink's middle) at time t: blinks come at seeded gaps
function StoryArtKit.blink(t: number, seed: number): number
	local D = StoryArtKit.DRONE
	local lo, hi = D.blinkEvery[1], D.blinkEvery[2]
	local period = lo + ((seed * 7919) % 1000) / 1000 * (hi - lo)
	local phase = (t + (seed % 13) * 0.37) % period
	if phase >= D.blinkFor then
		return 1
	end
	local k = math.abs(phase / D.blinkFor * 2 - 1) -- 1 at the edges, 0 in the middle
	return D.blinkMin + (1 - D.blinkMin) * k
end

-- Problems (empty when fine)
function StoryArtKit.check(Config: any): { string }
	local bad = {}
	for look, row in StoryArtKit.LOOKS do
		local fit = StoryArtKit.fit(Config, look)
		if not fit then
			table.insert(bad, look .. ": no fit row (run art/blender/story.py)")
			continue
		end
		if row.boxes then
			local size = StoryArtKit.union(StoryArtKit.BOXES[row.boxes])
			for k = 1, 3 do
				if math.abs(fit.frame[k] - size[k]) > 0.01 then
					table.insert(
						bad,
						string.format(
							"%s: built on %.2f, its boxes are %.2f (axis %d)",
							look,
							fit.frame[k],
							size[k],
							k
						)
					)
				end
			end
		end
		local f = fit.frame
		for _, m in StoryArtKit.meshes(Config, look) do
			for k = 1, 3 do
				-- (up: only the top counts; the bottom is the ground check below)
				local reach = (if k == 2 then m.offset[k] else math.abs(m.offset[k])) + m.size[k] / 2
				if reach > f[k] / 2 + row.reach[k] + 0.02 then
					table.insert(
						bad,
						string.format(
							"%s: %s reaches %.2f past its frame (axis %d)",
							look,
							m.name,
							reach - f[k] / 2,
							k
						)
					)
				end
			end
			-- rubble may settle a little into the ground (sink); nothing else goes under it
			local sink = if row.sink and m.name ~= row.moves then row.sink else 0.05
			if m.offset[2] - m.size[2] / 2 < -f[2] / 2 - sink then
				table.insert(bad, look .. ": " .. m.name .. " sinks under the ground")
			end
		end
		if row.moves and not fit.meshes[row.moves] then
			table.insert(bad, look .. ": no " .. row.moves .. " mesh")
		end
	end
	for look in Config.StoryArt or {} do
		if not StoryArtKit.LOOKS[look] then
			table.insert(bad, look .. ": not a story look")
		end
	end
	return bad
end

return StoryArtKit

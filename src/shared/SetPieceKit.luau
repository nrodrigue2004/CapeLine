--!strict
-- SetPieceKit: the side quests' set pieces dressed in Blender meshes (overnight queue item 10; the meshes are
-- art/blender/setpieces.py's, imported by nate as ReplicatedStorage.Art.SetPieces; each mesh's size, centre,
-- colour and material is Config.SetPieceArt, generated by the same script). Pure, so Lune checks it.
-- * A set (Shared.SideQuestSets) or a pocket (Shared.PocketLayout) lists its looks as placements:
--   { look, x, y, z, ry, piece, tint } (where the look's foot point stands, in the set's own studs, turned ry
--   degrees about up; `piece` the breakable piece it belongs to; `tint` mesh name -> { r, g, b } for the
--   meshes coloured per copy). Each box a look stands in for carries `art`, the placement's index.
-- * drawn(Config, places, has): the placements to draw as meshes: a look is drawn only when every one of its
--   meshes is found (has(name)), so a half import never shows half a look. Every box of a drawn placement is
--   kept but hidden (hides): it still collides, takes queries and makes up its breakable piece exactly as
--   before; the mesh itself never collides. Nothing found: every box is drawn as today (the fallback).
-- * meshes(Config, place): the look's meshes for one placement (size, offset from the foot, colour, material,
--   transparency), placed by SetPieceMeshes on the server.
-- * check(Config, places, boxes): each placement a known look whose meshes sit over the boxes it hides.

local SetPieceKit = {}

export type Place = {
	look: string,
	x: number,
	y: number,
	z: number,
	ry: number?,
	piece: string?,
	tint: { [string]: { number } }?,
}

export type Mesh = {
	name: string,
	size: { number },
	offset: { number },
	color: { number },
	mat: string,
	alpha: number,
}

-- The side quest escort trucks that have their own look (Config.SideQuests chain id -> look); the others keep
-- the motorcade box
SetPieceKit.TRUCKS = {
	HarvestKing = "FarmTruck", -- The Harvest King's farm folk's truck down the farm road (chain 4)
} :: { [string]: string }

-- Add a placement to a list; returns its index (the boxes it stands in for take it as `art`)
function SetPieceKit.place(
	list: { Place },
	look: string,
	x: number,
	y: number,
	z: number,
	ry: number?,
	piece: string?,
	tint: { [string]: { number } }?
): number
	table.insert(list, { look = look, x = x, y = y, z = z, ry = ry, piece = piece, tint = tint })
	return #list
end

-- Is every mesh of this look found?
function SetPieceKit.ready(Config: any, look: string, has: (string) -> boolean): boolean
	local fit = Config.SetPieceArt and Config.SetPieceArt[look]
	if type(fit) ~= "table" or next(fit) == nil then
		return false
	end
	for name in fit do
		if not has(name) then
			return false
		end
	end
	return true
end

-- The placements drawn as meshes: index -> true (empty when nothing is imported)
function SetPieceKit.drawn(Config: any, places: { Place }?, has: (string) -> boolean): { [number]: boolean }
	local out = {}
	local seen: { [string]: boolean } = {}
	for i, pl in places or {} do
		local ok = seen[pl.look]
		if ok == nil then
			ok = SetPieceKit.ready(Config, pl.look, has)
			seen[pl.look] = ok
		end
		if ok then
			out[i] = true
		end
	end
	return out
end

-- Is this box hidden behind its look's meshes?
function SetPieceKit.hides(box: any, drawn: { [number]: boolean }): boolean
	local a = box.art
	return type(a) == "number" and drawn[a] == true
end

-- One placement's meshes, sorted by name (offsets from the placement's foot, before its turn)
function SetPieceKit.meshes(Config: any, place: Place): { Mesh }
	local out: { Mesh } = {}
	local fit = Config.SetPieceArt and Config.SetPieceArt[place.look]
	if type(fit) ~= "table" then
		return out
	end
	for name, f in fit do
		local tint = place.tint and place.tint[name]
		table.insert(out, {
			name = name,
			size = f.size,
			offset = f.offset,
			color = tint or f.color,
			mat = f.mat or "SmoothPlastic",
			alpha = f.alpha or 0,
		})
	end
	table.sort(out, function(a, b)
		return a.name < b.name
	end)
	return out
end

-- A box's half extents (a round or tilted box by its largest side; SideQuestSets' upright cylinder stands sx
-- tall, PocketLayout's (BoxKit) sy tall)
local function half(b: any): (number, number, number, number, number, number)
	local x = b.x or b.cx
	local y = b.y or b.cy
	local z = b.z or b.cz
	if b.shape or b.tilt then
		local m = math.max(b.sx, b.sy, b.sz) / 2
		return x, y, z, m, m, m
	end
	return x, y, z, b.sx / 2, b.sy / 2, b.sz / 2
end

-- The box round a placement's meshes, in the set's studs: lo, hi ({ x, y, z } each)
function SetPieceKit.bounds(Config: any, place: Place): ({ number }, { number })
	local lo = { math.huge, math.huge, math.huge }
	local hi = { -math.huge, -math.huge, -math.huge }
	local a = math.rad(place.ry or 0)
	local c, s = math.cos(a), math.sin(a)
	for _, m in SetPieceKit.meshes(Config, place) do
		for dx = -1, 1, 2 do
			for dz = -1, 1, 2 do
				for dy = -1, 1, 2 do
					local lx = m.offset[1] + dx * m.size[1] / 2
					local ly = m.offset[2] + dy * m.size[2] / 2
					local lz = m.offset[3] + dz * m.size[3] / 2
					-- Roblox's turn about up: x' = x cos + z sin, z' = -x sin + z cos
					local wx = place.x + lx * c + lz * s
					local wy = place.y + ly
					local wz = place.z - lx * s + lz * c
					lo[1], hi[1] = math.min(lo[1], wx), math.max(hi[1], wx)
					lo[2], hi[2] = math.min(lo[2], wy), math.max(hi[2], wy)
					lo[3], hi[3] = math.min(lo[3], wz), math.max(hi[3], wz)
				end
			end
		end
	end
	return lo, hi
end

-- Problems with a set's looks (empty when fine): each placement a known look, standing in for at least one
-- box of its own piece, its meshes over those boxes (their middle inside the meshes, the meshes no more than
-- `slack` studs past them, twice that upward), and no box pointing at a missing placement
function SetPieceKit.check(Config: any, places: { Place }?, boxes: { any }, slack: number?): { string }
	local bad = {}
	local list = places or {}
	local pad = slack or 6
	local own: { [number]: { any } } = {}
	for i, b in boxes do
		local a = b.art
		if a ~= nil then
			if type(a) ~= "number" or list[a] == nil then
				table.insert(bad, string.format("box %d: no placement %s", i, tostring(a)))
			else
				own[a] = own[a] or {}
				table.insert(own[a], b)
			end
		end
	end
	for i, pl in list do
		local name = string.format("%d %s", i, tostring(pl.look))
		local fit = Config.SetPieceArt and Config.SetPieceArt[pl.look]
		local mine = own[i]
		if type(fit) ~= "table" then
			table.insert(bad, name .. ": unknown look")
		elseif not mine then
			table.insert(bad, name .. ": stands in for no box")
		else
			local blo = { math.huge, math.huge, math.huge }
			local bhi = { -math.huge, -math.huge, -math.huge }
			for _, b in mine do
				if b.piece ~= pl.piece then
					table.insert(bad, name .. ": a box of another piece")
				end
				if b.sign then
					table.insert(bad, name .. ": hides a sign")
				end
				local x, y, z, hx, hy, hz = half(b)
				blo[1], bhi[1] = math.min(blo[1], x - hx), math.max(bhi[1], x + hx)
				blo[2], bhi[2] = math.min(blo[2], y - hy), math.max(bhi[2], y + hy)
				blo[3], bhi[3] = math.min(blo[3], z - hz), math.max(bhi[3], z + hz)
			end
			local mlo, mhi = SetPieceKit.bounds(Config, pl)
			for k = 1, 3 do
				local mid = (blo[k] + bhi[k]) / 2
				if mid < mlo[k] - 1 or mid > mhi[k] + 1 then
					table.insert(
						bad,
						string.format("%s: its boxes' middle is off the meshes (axis %d)", name, k)
					)
				end
				-- (upward a look may rise twice as far: an awning, a gate's crest or a statue over plain boxes)
				if mlo[k] < blo[k] - pad or mhi[k] > bhi[k] + (if k == 2 then pad * 2 else pad) then
					table.insert(bad, string.format("%s: the meshes reach past its boxes (axis %d)", name, k))
				end
			end
		end
	end
	return bad
end

-- The truck look for a chain's escort, or nil (the motorcade box)
function SetPieceKit.truck(chainId: any): string?
	return if type(chainId) == "string" then SetPieceKit.TRUCKS[chainId] else nil
end

return SetPieceKit

--!strict
-- SoundPick: which recorded sound a Config.Audio or Config.Life row plays (the sounds pass, 2026-11-19; nate's
-- playtest: "need better sounds badly"). Pure (no Roblox instances), so Lune tests it.
-- The game's sounds live in a few atlas assets (Config.AudioClips, generated by art/audio/build.py and music.py):
-- each clip is a region { atlas, start, length, loop } of one uploaded audio file. A row names its clip with
-- `clip` (a key in AudioClips.clips, or the stem of variants `clip_1`..`clip_n`, picked at random with no
-- immediate repeat). A row whose atlas has no id yet (0) resolves to nil and the AudioController plays its
-- built-in `fallback` as before.

local SoundPick = {}

export type Region = { start: number, length: number }
export type Pick = { id: string, regions: { Region }, loop: boolean, atlas: string }

-- every region for a clip key: the clip itself, or its numbered variants
function SoundPick.variants(Clips: any, key: string): ({ Region }, string?, boolean)
	local out: { Region } = {}
	local atlas: string? = nil
	local loop = false
	local one = Clips.clips[key]
	if one then
		return { { start = one[2], length = one[3] } }, one[1], one[4] == true
	end
	local i = 1
	while true do
		local c = Clips.clips[key .. "_" .. i]
		if not c then
			break
		end
		table.insert(out, { start = c[2], length = c[3] })
		atlas = c[1]
		loop = c[4] == true
		i += 1
	end
	return out, atlas, loop
end

local cache: { [any]: Pick | false } = setmetatable({}, { __mode = "k" }) :: any

-- The row's recorded sound (atlas id and regions), or nil while it has none (fallback plays)
function SoundPick.resolve(Config: any, row: any): Pick?
	if type(row) ~= "table" or type(row.clip) ~= "string" then
		return nil
	end
	local hit = cache[row]
	if hit == false then
		return nil
	elseif hit then
		return hit :: Pick
	end
	local Clips = Config.AudioClips
	local regions, atlas, loop = SoundPick.variants(Clips, row.clip)
	local id = atlas and Clips.atlases[atlas] or 0
	if #regions == 0 or not atlas or id <= 0 then
		cache[row] = false
		return nil
	end
	local p: Pick =
		{ id = "rbxassetid://" .. string.format("%d", id), regions = regions, loop = loop, atlas = atlas }
	cache[row] = p
	return p
end

-- A variant index in 1..n, never `last` again when there is a choice (u is a random number in [0, 1))
function SoundPick.choose(n: number, last: number?, u: number): number
	if n <= 1 then
		return 1
	end
	if last and last >= 1 and last <= n then
		local k = math.floor(u * (n - 1)) + 1 -- 1..n-1
		return if k >= last then k + 1 else k
	end
	return math.floor(u * n) + 1
end

-- The playback speed for a recorded clip: its own `clipPitch` (default 1), times the caller's asked pitch as a
-- ratio of the row's fallback pitch (callers pass `row.pitch * k`), else a random spread of `vary` (default 5% on
-- 3D rows, none on 2D ones: chimes and stings stay in tune)
function SoundPick.pitch(row: any, asked: number?, u: number): number
	local base = row.clipPitch or 1
	if asked then
		return base * asked / (row.pitch or 1)
	end
	local v = row.vary or (if row.range then 0.05 else 0) -- 2D rows are mostly musical: no detune
	return base * (1 + (u * 2 - 1) * v)
end

-- The volume for one play: the row's (or the caller's) with a small random spread (`volVary`, default 0.08)
function SoundPick.volume(row: any, asked: number?, u: number): number
	local v = asked or row.volume or 0.5
	local spread = row.volVary or 0.08
	return v * (1 + (u * 2 - 1) * spread)
end

return SoundPick

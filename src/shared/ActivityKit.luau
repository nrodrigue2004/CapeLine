-- The base radius ActRing is built for (a ring's LookScale is its radius over this)
ActivityKit.RING = 10

-- The Harbour fog bank's look (Fx.ActivityFx; one mesh the size of today's 90 x 16 x 90 ball)
ActivityKit.FOG = "ActFog"

function ActivityKit.kind(name: any): Kind?
	return if type(name) == "string" then KINDS[name] else nil
end

-- A look's fit table: Config.ActivityArt, or Config.VehicleArt for the reused vehicles
function ActivityKit.fit(Config: any, look: string): { [string]: any }?
	local a = Config.ActivityArt and Config.ActivityArt[look]
	if type(a) == "table" then
		return a
	end
	local v = Config.VehicleArt and Config.VehicleArt[look]
	return if type(v) == "table" then v else nil
end

-- Is every mesh of this look found?
function ActivityKit.ready(Config: any, look: string, has: (string) -> boolean): boolean
	local fit = ActivityKit.fit(Config, look)
	if fit == nil or next(fit) == nil then
		return false
	end
	for name in fit do
		if not has(name) then
			return false
		end
	end
	return true
end

export type Mesh = {
	name: string,
	size: { number },
	offset: { number },
	color: { number },
	mat: string,
	alpha: number,
	maps: boolean,
	tintFrom: string?, -- the part whose colour it takes (the device reads it)
}

-- A kind's meshes, sorted by name, scaled by s across x and z (offsets from the foot)
function ActivityKit.meshes(Config: any, kind: Kind, s: number?): { Mesh }
	local out: { Mesh } = {}
	local fit = ActivityKit.fit(Config, kind.look)
	if fit == nil then
		return out
	end
	local k = if kind.scale then (s or 1) else 1
	for name, f in fit do
		local t = kind.tint and kind.tint[name]
		table.insert(out, {
			name = name,
			size = { f.size[1] * k, f.size[2], f.size[3] * k },
			offset = { f.offset[1] * k, f.offset[2], f.offset[3] * k },
			color = if type(t) == "table" then t else f.color,
			mat = f.mat or "SmoothPlastic",
			alpha = f.alpha or 0,
			maps = f.maps == true,
			tintFrom = if type(t) == "string" then t else nil,
		})
	end
	table.sort(out, function(a, c)
		return a.name < c.name
	end)
	return out
end

-- Does the device hide this part under the look? (never the anchor or a kept part)
function ActivityKit.hides(kind: Kind, partName: string): boolean
	if partName == (kind.on or "Root") or partName == "Root" then
		return false
	end
	return not (kind.keep and table.find(kind.keep, partName) ~= nil)
end

-- The props to dress this round: ids sorted nearest first, within the preset's radius, at most `looks` of them
-- and at most `parts` meshes in all (each candidate { id, dist, meshes })
function ActivityKit.pick(
	cands: { { id: any, dist: number, meshes: number } },
	budget: { radius: number, looks: number, parts: number }
): { [any]: boolean }
	table.sort(cands, function(a, c)
		return a.dist < c.dist
	end)
	local out = {}
	local n, parts = 0, 0
	for _, c in cands do
		if c.dist > budget.radius or n >= budget.looks then
			break
		end
		if parts + c.meshes <= budget.parts then
			out[c.id] = true
			n += 1
			parts += c.meshes
		end
	end
	return out
end

-- Problems with every kind (empty when fine): a known look whose meshes sit over the kind's boxes (Shared.
-- SetPieceKit.check's rule), each tint naming a mesh of the look
function ActivityKit.check(Config: any, SetPieceKit: any): { string }
	local bad = {}
	for name, kind in KINDS do
		local fit = ActivityKit.fit(Config, kind.look)
		if not fit then
			table.insert(bad, name .. ": no fit table for " .. kind.look)
		else
			for mesh in kind.tint or {} do
				if fit[mesh] == nil then
					table.insert(bad, name .. ": tints a mesh it does not have, " .. mesh)
				end
			end
			-- SetPieceKit.check looks fit tables up itself: hand it a Config that knows this look
			local cfg = { SetPieceArt = { [kind.look] = fit } }
			local boxes = {}
			for _, bx in kind.boxes do
				local c = table.clone(bx :: any)
				c.art = 1
				table.insert(boxes, c)
			end
			for _, p in
				SetPieceKit.check(cfg, { { look = kind.look, x = 0, y = 0, z = 0, ry = 0 } }, boxes, 6)
			do
				table.insert(bad, name .. ": " .. p)
			end
		end
	end
	return bad
end

return ActivityKit

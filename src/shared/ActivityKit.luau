--!strict
-- ActivityKit: the open-world activities' props (24 incidents, 12 events, 12 contract types) dressed in Blender
-- meshes (art/blender/activity.py, imported as ReplicatedStorage.Art.Activity; each mesh's size, centre, colour and
-- material is Config.ActivityArt, generated by the same script). Pure, so Lune checks it.
-- * The services build every prop from plain parts exactly as before (SiteKit, IncidentService, EventService,
--   ContractService) and tag its model with the Look attribute (a KINDS key; SiteKit.look). The parts never
--   collide (SiteKit.part), and every combat target, hold ring, drop circle, pickup range and prompt is a number in
--   the services: none of that changes.
-- * The device (Fx.ActivityProps) draws a tagged prop's look welded to its anchor part (Root, or `on`), within the
--   preset's budget (Config.Presets.<preset>.sites) and only once every mesh of the look is imported (the
--   all-or-nothing rule of Shared.SetPieceKit), and hides that prop's parts on that device only, except the parts
--   named in `keep` (a ring's or drop circle's coloured disc, a stadium gate's barrier). Nothing imported, out of
--   budget or too far: today's parts show (the fallback).
-- * boxes: the parts each kind builds today, in its foot's studs (the services' own numbers, mirrored here for the
--   tests: SetPieceKit.check holds the meshes over them); target: the combat target's lift and radius where the
--   prop is a SiteKit.object (tests hold these to the services).
-- * tint: mesh name -> the part whose colour it takes (a generator's core, a ring's or a pickup's colour), or a
--   fixed { r, g, b }. scale: the kind takes the LookScale attribute (a ring's radius / 10) across x and z.
-- * The tram and the escort truck reuse art/blender/vehicles.py's Tram and DockTruck (Config.VehicleArt, imported
--   as Art.Vehicles); the towed car already wears the CarSedan look on the server (IncidentService).

local ActivityKit = {}

export type Box = {
	x: number,
	y: number,
	z: number,
	sx: number,
	sy: number,
	sz: number,
	shape: string?, -- a round part (measured by its largest side)
	tilt: boolean?, -- a turned part (measured by its largest side)
	art: number?,
}

export type Kind = {
	look: string,
	boxes: { Box },
	on: string?, -- the anchor part's name (default Root)
	keep: { string }?, -- parts that stay shown under the look
	tint: { [string]: string | { number } }?,
	scale: boolean?,
	target: { lift: number, radius: number }?,
	moves: boolean?, -- the prop drives, flies or falls (the look rides its anchor)
}

local function b(x: number, y: number, z: number, sx: number, sy: number, sz: number, extra: any?): Box
	local out: any = { x = x, y = y, z = z, sx = sx, sy = sy, sz = sz }
	for k, v in extra or {} do
		out[k] = v
	end
	return out
end

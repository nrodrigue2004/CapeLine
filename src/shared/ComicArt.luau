--!strict
-- ComicArt: which rendered comic image a comic page panel or a guide's or mentor's portrait shows (the comic
-- art pass, 2026-11-19; Config.ComicArt, generated by art/panels/post.py). Pure: no Roblox instances, so Lune
-- tests it. An id of 0 (not uploaded yet) answers nil, and the UI draws today's frames instead.
local ComicArt = {}

export type Portrait = { image: string, offset: { number }, size: { number } }

-- The panel's image ("rbxassetid://..."), or nil
function ComicArt.panel(Config: any, page: string, index: number): string?
	local art = Config.ComicArt
	local id = art and art.panels[page .. "." .. index]
	if not id or id == 0 then
		return nil
	end
	return "rbxassetid://" .. id
end

-- The portrait's sheet image and its cell (pixel offset and size for ImageRectOffset and ImageRectSize), or nil
function ComicArt.portrait(Config: any, key: string): Portrait?
	local art = Config.ComicArt
	if not art then
		return nil
	end
	local k = art.aliases[key] or key
	local at = art.portraits[k]
	if not at then
		return nil
	end
	local id = art.sheets[at[1]]
	if not id or id == 0 then
		return nil
	end
	local c = art.cell
	return { image = "rbxassetid://" .. id, offset = { at[2] * c, at[3] * c }, size = { c, c } }
end

-- Every key a portrait could be asked for (the speakers, the side quest givers and the mentors), for tests
function ComicArt.portraitKeys(Config: any): { string }
	local out = {}
	for k in Config.Story.guides.speakers do
		table.insert(out, k)
	end
	for k in Config.SideQuests.givers do
		table.insert(out, k)
	end
	for _, m in Config.Mentors.list do
		table.insert(out, m.id)
	end
	table.sort(out)
	return out
end

return ComicArt

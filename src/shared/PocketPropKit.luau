--!strict
-- PocketPropKit: the pockets' most-seen props (desks, chairs, lockers, cabinets, tanks, cages, dummies, bags, pads,
-- posts, braziers, screen desks, camera rigs, barriers, chimneys, water tanks) in art/blender/pocketprops.py's
-- meshes (gap-props2, 2026-11-19; imported as ReplicatedStorage.Art.PocketProps, each look's frame and meshes in
-- Config.PocketPropArt, generated by the same script from these placements). Pure, so Lune checks it.
-- * places(Config, l, dress, layout): finds each prop's boxes in a built pocket (Config.PocketProps rules: a core
--   box and its companions) and lays a look over them: the box round those boxes in the look's own turn. Nothing
--   on a box is changed: the boxes stay exactly where, how big and how solid they are.
-- * pick(Config, places, preset, ready): what one device draws: looks whose every mesh is imported, dressing looks
--   only where their boxes' tier is within the preset's, in rule order until the preset's mesh budget
--   (Config.Presets <preset>.pockets.props) runs out. Its boxes are then hidden (a layout box: the part made by
--   the server, still colliding as before) or never built (a dressing box: ghost only). Nothing imported: nothing
--   drawn, every box shows as today.
-- * key(x, y, z): how a device finds the part the server made for a box (its centre, to 1/20 stud).
-- The fit helpers are Shared.DeepArtKit's over Config.PocketPropArt and Config.PocketPropArt2.
-- The second set (gap-props3, 2026-11-19): blackboards, hoops, Halo's statue, the bookcase, the conveyor and its
-- half-built robots, trophy shelves, the bench, wooden dummies, the sealed and iron doors, Hoshi's cage and chains,
-- the roll door, scanner arch and dock crates, the stations, the tower mast and Live's stage, in their own FBX
-- (Art.PocketProps2, Config.PocketPropArt2) so the first upload stays as it is. Two rule options came with them:
-- * ry = "box": the placement turns with its core box's own turn (the chains run diagonally)
-- * a `with` entry's third field "keep": those boxes frame the look (its meshes may reach round them) but stay
--   drawn and are never hidden (Live's giant screen behind its stage)

local DeepArtKit = if script then require(script.Parent.DeepArtKit) else (require :: any)("./DeepArtKit")

local PocketPropKit = {}

export type Place = {
	look: string,
	cx: number,
	cy: number,
	cz: number,
	sx: number,
	sy: number,
	sz: number,
	ry: number,
	tint: string?,
	dress: boolean, -- its boxes are PocketDress dressing (dress.extras), not layout boxes (l.boxes)
	boxes: { number }, -- indices into l.boxes or dress.extras (hidden or not built when the look is drawn)
	keep: { number }?, -- boxes the look frames but leaves drawn (a `with` entry's "keep")
	tier: number, -- the highest tier among its boxes (1 for layout boxes)
	rule: number,
}

-- The art sets, in the order their meshes are looked up (ReplicatedStorage.Art.<set>) and their fit tables
PocketPropKit.SETS =
	{ { set = "PocketProps", fit = "PocketPropArt" }, { set = "PocketProps2", fit = "PocketPropArt2" } }

local views: { [any]: any } = setmetatable({}, { __mode = "k" }) :: any
local function view(Config: any): any
	local v = views[Config]
	if v then
		return v
	end
	local all = {}
	for _, s in PocketPropKit.SETS do
		for look, fit in Config[s.fit] or {} do
			all[look] = fit
		end
	end
	v = { DeepArt = all, City = Config.City }
	views[Config] = v
	return v
end

-- Every look's fit (both sets)
function PocketPropKit.all(Config: any): { [string]: any }
	return view(Config).DeepArt
end

function PocketPropKit.fit(Config: any, look: string): any?
	return DeepArtKit.fit(view(Config), look)
end

function PocketPropKit.ready(Config: any, look: string, has: (string) -> boolean): boolean
	return DeepArtKit.ready(view(Config), look, has)
end

function PocketPropKit.readyLooks(Config: any, has: (string) -> boolean): { [string]: boolean }
	return DeepArtKit.readyLooks(view(Config), has)
end

function PocketPropKit.meshes(Config: any, place: Place): { DeepArtKit.Mesh }
	return DeepArtKit.meshes(view(Config), place)
end

-- "kind:color:sx:sy:sz" -> its parts
type Sig = { kind: string, color: string, size: { number } }
local sigCache: { [string]: Sig } = {}
local function sig(s: string): Sig
	local hit = sigCache[s]
	if hit then
		return hit
	end
	local parts = string.split(s, ":")
	assert(#parts == 5, "bad prop signature " .. s)
	local out = {
		kind = parts[1],
		color = parts[2],
		size = { tonumber(parts[3]) :: number, tonumber(parts[4]) :: number, tonumber(parts[5]) :: number },
	}
	sigCache[s] = out
	return out
end

local function matches(b: any, s: Sig): boolean
	return b.kind == s.kind
		and (s.color == "*" or b.color == s.color)
		and math.abs(b.sx - s.size[1]) < 0.01
		and math.abs(b.sy - s.size[2]) < 0.01
		and math.abs(b.sz - s.size[3]) < 0.01
end

-- The quarter turn whose front (local -z) points from (x, z) toward (tx, tz): Roblox's turn about up sends local -z
-- to world (-sin ry, -cos ry)
local function faceTurn(x: number, z: number, tx: number, tz: number): number
	local dx, dz = tx - x, tz - z
	if math.abs(dx) > math.abs(dz) then
		return if dx > 0 then -90 else 90
	end
	return if dz > 0 then 180 else 0
end

local function r3(v: number): number
	return math.floor(v * 1000 + 0.5) / 1000
end

-- The box round `list`, turned ry degrees about up with its middle near (cx, cz)
local function cover(
	list: { any },
	cx: number,
	cz: number,
	ry: number
): (number, number, number, number, number, number)
	local a = math.rad(ry)
	local c, s = math.cos(a), math.sin(a)
	local lo = { math.huge, math.huge, math.huge }
	local hi = { -math.huge, -math.huge, -math.huge }
	for _, b in list do
		for _, q in DeepArtKit.corners(b) do
			local dx, dz = q[1] - cx, q[3] - cz
			local l = { dx * c - dz * s, q[2], dx * s + dz * c }
			for k = 1, 3 do
				lo[k] = math.min(lo[k], l[k])
				hi[k] = math.max(hi[k], l[k])
			end
		end
	end
	local mx, mz = (lo[1] + hi[1]) / 2, (lo[3] + hi[3]) / 2
	return r3(cx + mx * c + mz * s),
		r3((lo[2] + hi[2]) / 2),
		r3(cz - mx * s + mz * c),
		r3(hi[1] - lo[1]),
		r3(hi[2] - lo[2]),
		r3(hi[3] - lo[3])
end

-- Every prop placement in a built pocket (l: PocketLayout.build, dress: PocketDress.apply's, for this layout)
function PocketPropKit.places(Config: any, l: any, dress: any, layout: string): { Place }
	local out: { Place } = {}
	local claimed: { [string]: { [number]: boolean } } = { box = {}, dress = {} }
	for ri, rule in (Config.PocketProps and Config.PocketProps.rules) or {} do
		if rule.layout ~= layout then
			continue
		end
		local list: { any } = if rule.dress then (dress and dress.extras or {}) else l.boxes
		local taken = claimed[if rule.dress then "dress" else "box"]
		local core = sig(rule.core)
		for i, b in list do
			if taken[i] or not matches(b, core) then
				continue
			end
			local group, idx, keep = { b }, { i }, {}
			local ok = true
			local mine: { [number]: boolean } = { [i] = true }
			local withBoxes: { any } = {}
			for wi, w in rule.with or {} do
				local ws = sig(w[1])
				local found = {}
				for j, o in list do
					if not taken[j] and not mine[j] and matches(o, ws) then
						local d = math.sqrt((o.cx - b.cx) ^ 2 + (o.cz - b.cz) ^ 2)
						if d <= (rule.reach or 0) + 0.01 then
							table.insert(found, { j = j, d = d })
						end
					end
				end
				table.sort(found, function(p, q)
					return if math.abs(p.d - q.d) > 1e-6 then p.d < q.d else p.j < q.j
				end)
				if #found < w[2] then
					ok = false
					break
				end
				for k = 1, w[2] do
					local j = found[k].j
					mine[j] = true
					table.insert(group, list[j])
					table.insert(if w[3] == "keep" then keep else idx, j)
					if k == 1 then
						withBoxes[wi] = list[j]
					end
				end
			end
			if not ok then
				continue
			end
			for _, j in idx do
				taken[j] = true
			end
			for _, j in keep do
				taken[j] = true
			end
			local ry = if rule.face
				then faceTurn(b.cx - l.cx, b.cz - l.cz, rule.face[1], rule.face[2])
				elseif rule.ry == "box" then (b.ry or 0)
				else (rule.ry or 0)
			local cx, cy, cz, sx, sy, sz = cover(group, b.cx, b.cz, ry)
			local tier = 1
			for _, g in group do
				tier = math.max(tier, g.tier or 1)
			end
			local tintBox = if rule.tint == 0 then b elseif rule.tint then withBoxes[rule.tint] else nil
			table.insert(out, {
				look = rule.look,
				cx = cx,
				cy = cy,
				cz = cz,
				sx = sx,
				sy = sy,
				sz = sz,
				ry = ry,
				tint = if tintBox then (tintBox.tint or tintBox.color) else nil,
				dress = rule.dress == true,
				boxes = idx,
				keep = if #keep > 0 then keep else nil,
				tier = tier,
				rule = ri,
			})
		end
	end
	return out
end

-- The meshes this placement draws
function PocketPropKit.cost(Config: any, place: Place): number
	local fit = PocketPropKit.fit(Config, place.look)
	local n = 0
	for _ in if fit then fit.meshes else {} do
		n += 1
	end
	return n
end

-- What one device draws of a pocket's placements for its preset (ready: look -> true once imported)
function PocketPropKit.pick(
	Config: any,
	places: { Place },
	preset: string,
	ready: { [string]: boolean }
): { Place }
	local pr = Config.Presets[preset] or Config.Presets.low
	local budget = (pr.pockets and pr.pockets.props) or 0
	local tier = (pr.pockets and pr.pockets.tier) or 1
	local out = {}
	local used = 0
	for _, p in places do
		if not ready[p.look] or (p.dress and p.tier > tier) then
			continue
		end
		local c = PocketPropKit.cost(Config, p)
		if used + c > budget then
			continue
		end
		used += c
		table.insert(out, p)
	end
	return out
end

-- A part's lookup key by its centre (the server makes a layout box's part centred on the box)
function PocketPropKit.key(x: number, y: number, z: number): string
	return string.format(
		"%d_%d_%d",
		math.floor(x * 20 + 0.5),
		math.floor(y * 20 + 0.5),
		math.floor(z * 20 + 0.5)
	)
end

-- Problems (empty when fine): each rule finds its count, every placement's look is fitted and built for its boxes
-- (never stretched), every box inside its placement, the meshes inside it (Config.PocketProps.slack), tints known
function PocketPropKit.check(Config: any, l: any, dress: any, layout: string): { string }
	local bad = {}
	local places = PocketPropKit.places(Config, l, dress, layout)
	local found: { [number]: number } = {}
	for _, p in places do
		found[p.rule] = (found[p.rule] or 0) + 1
	end
	for ri, rule in Config.PocketProps.rules do
		if rule.layout == layout and (found[ri] or 0) ~= rule.count then
			table.insert(
				bad,
				string.format(
					"%s rule %d %s: found %d, wants %d",
					layout,
					ri,
					rule.look,
					found[ri] or 0,
					rule.count
				)
			)
		end
	end
	local slack = Config.PocketProps.slack
	for i, p in places do
		local name = string.format("%s place %d %s", layout, i, p.look)
		local fit = PocketPropKit.fit(Config, p.look)
		if not fit then
			table.insert(bad, name .. ": no fit (run art/blender/pocketprops.py)")
			continue
		end
		local f = fit.frame
		if math.abs(f[1] - p.sx) > 0.02 or math.abs(f[2] - p.sy) > 0.02 or math.abs(f[3] - p.sz) > 0.02 then
			table.insert(
				bad,
				string.format(
					"%s: frame %.2f %.2f %.2f, boxes %.2f %.2f %.2f",
					name,
					f[1],
					f[2],
					f[3],
					p.sx,
					p.sy,
					p.sz
				)
			)
		end
		if p.tint and not Config.City.palette[p.tint] then
			table.insert(bad, name .. ": no palette colour " .. p.tint)
		end
		local list = if p.dress then dress.extras else l.boxes
		local every = table.clone(p.boxes)
		for _, j in p.keep or {} do
			table.insert(every, j)
		end
		for _, j in every do
			for _, q in DeepArtKit.corners(list[j]) do
				if not DeepArtKit.inside(p, q[1], q[2], q[3], 0.05) then
					table.insert(bad, string.format("%s: box %d pokes out", name, j))
					break
				end
			end
		end
		for _, m in PocketPropKit.meshes(Config, p) do
			for k, s in { p.sx, p.sy, p.sz } do
				if math.abs(m.offset[k]) + m.size[k] / 2 > s / 2 + slack then
					table.insert(bad, string.format("%s: %s reaches past its box (axis %d)", name, m.name, k))
				end
			end
		end
	end
	return bad
end

return PocketPropKit

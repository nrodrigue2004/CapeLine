--!strict
-- HqArtKit: the HQ art pass (2026-11-18). Where art/blender/hq.py's meshes go in the HQ rooms, imported by nate
-- as ReplicatedStorage.Art.Hq (each mesh's size, centre, colour and material is Config.HqArt, generated by the
-- same script). Pure, so Lune checks it; HqClient draws from it (Client.Fx.HqMeshes finds and clones the meshes).
-- The same rule as the set pieces (Shared.SetPieceKit): a look is drawn only when every one of its meshes is
-- found, so a half import never shows half a look; the parts it stands in for stay (hidden), so every prompt,
-- sign and SurfaceGui on them works exactly as before; nothing imported, every part is drawn as today.
-- Two ways a look is drawn:
-- * placed: at a foot point (cell offsets, y up from the floor) turned ry degrees about up, at its own size:
--   the station consoles and pads (one look per side: the Vigil's rounded white, blue and gold; the Dread
--   Syndicate's angular black iron, red and gold with spikes), the Trophy Wall's frame, plaques and trophies,
--   the WANTED board, the head mounts and their name plates, the statues' plinths, the thank-you and
--   collection props and the reputation tiers' dressing (Shared.RepTiers pieces by name).
-- * filled: one shape stretched over a part of any size (fill): the training dummies' base, target and visor
--   (the dummy and the big boss sim dummy) and the nemesis pieces on the head mounts and the poster's bust
--   (Shared.WantedRules: skull, faceplate, jaw, horn, spike, visor, chest, shoulders, cape), each in the
--   part's own colour and material.
-- scene(Config, side) lists every placed look of a full HQ with the parts it hides (for the tests and the
-- preview, art/hq/layout.luau); HqClient uses the same spot helpers, so the two never drift apart.

local SetPieceKit = if script then require(script.Parent.SetPieceKit) else (require :: any)("./SetPieceKit")
local RepTiers = if script then require(script.Parent.RepTiers) else (require :: any)("./RepTiers")
local WantedRules = if script then require(script.Parent.WantedRules) else (require :: any)("./WantedRules")

local HqArtKit = {}

export type Place = SetPieceKit.Place
export type Mesh = SetPieceKit.Mesh

-- The sides' room colours (HqClient's floor trim, walls, light bands and today's pads)
HqArtKit.COLORS = {
	hero = { main = { 70, 140, 255 }, trim = { 240, 244, 255 } },
	villain = { main = { 210, 60, 60 }, trim = { 40, 36, 44 } },
} :: { [string]: { main: { number }, trim: { number } } }

-- "V" (the Vigil) or "S" (the Dread Syndicate): the end of a side's look names
function HqArtKit.tag(side: string?): string
	return if side == "villain" then "S" else "V"
end


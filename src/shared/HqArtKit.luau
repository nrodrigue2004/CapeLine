-- The wall frame's turn about up (degrees): its -z looks into the room
function HqArtKit.wallYaw(Config: any): number
	local w = Config.Hq.wanted.wall
	return math.deg(math.atan2(-w.nx, -w.nz))
end

-- The poster's two pins, in the wall frame (as HqClient's wantedPoster draws them)
function HqArtKit.pins(Config: any): { { number } }
	local s = WantedRules.layout(Config).poster
	local out = {}
	for _, k in { -1, 1 } do
		table.insert(out, { s.x + k * (s.sx / 2 - 0.4), s.y + s.sy / 2 - 0.4, s.z - 0.1 })
	end
	return out
end


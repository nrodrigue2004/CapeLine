-- Today's prop part (HqClient props): its size, its middle's height and whether it is tilted
function HqArtKit.propBox(bit: number): ({ number }, number, boolean)
	if bit == 6 then
		return { 1, 4, 0.4 }, 6, true -- the key, turned 30 degrees
	elseif bit == 1 then
		return { 6, 2, 0.4 }, 1.5, false
	end
	return { 3, 3, 3 }, 1.5, false
end

-- A spot's facing: into the room, away from the nearest wall (degrees about up; 0 faces -z)
function HqArtKit.facing(x: number, z: number): number
	if math.abs(x) > math.abs(z) then
		return if x < 0 then -90 else 90
	end
	return if z < 0 then 180 else 0
end


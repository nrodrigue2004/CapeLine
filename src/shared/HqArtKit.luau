-- The dressing's looks: placements (cell offsets) and, for each piece index, the placement it hides under
function HqArtKit.dressing(side: string?, pieces: { RepTiers.Piece }): ({ Place }, { [number]: number })
	local map = HqArtKit.DRESS[HqArtKit.tag(side)] or {}
	local places: { Place } = {}
	local hides: { [number]: number } = {}
	for i, p in pieces do
		local d = map[p.name]
		if d then
			local k = SetPieceKit.place(places, d.look, p.x, p.y, p.z, d.ry or 0)
			hides[i] = k
			-- the pieces it covers: the nearest of each name not yet taken
			for _, name in d.covers or {} do
				local best, bestD = nil, math.huge
				for j, q in pieces do
					if q.name == name and hides[j] == nil then
						local dd = (q.x - p.x) ^ 2 + (q.y - p.y) ^ 2 + (q.z - p.z) ^ 2
						if dd < bestD then
							best, bestD = j, dd
						end
					end
				end
				if best then
					hides[best] = k
				end
			end
		end
	end
	return places, hides
end


	dummyTarget = { look = "HqDummy", meshes = { "HqDummyTarget", "HqDummyRings" } },
	dummyVisor = { look = "HqDummy", meshes = { "HqDummyVisor" } },
	skull = { look = "HqNemesis", meshes = { "HqNemSkull" } },
	faceplate = { look = "HqNemesis", meshes = { "HqNemFace" } },
	jaw = { look = "HqNemesis", meshes = { "HqNemJaw" } },
	horn = { look = "HqNemesis", meshes = { "HqNemHorn" } },
	spike = { look = "HqNemesis", meshes = { "HqNemSpike" } },
	visor = { look = "HqNemesis", meshes = { "HqNemVisor" } },
	chest = { look = "HqNemesis", meshes = { "HqNemChest" } },
	shoulders = { look = "HqNemesis", meshes = { "HqNemShoulders" } },
	cape = { look = "HqNemesis", meshes = { "HqNemCape" } },
} :: { [string]: Shape }

-- The meshes that fill a part of `size` for a shape, sized and offset from the part's middle in its own frame
-- (their joint box stretched to the part's box). Empty for an unknown shape.
function HqArtKit.fill(Config: any, shape: string, size: { number }): { Mesh }
	local sh = HqArtKit.SHAPES[shape]
	local fit = sh and SetPieceKit.fit(Config, sh.look)
	if not sh or not fit then
		return {}
	end
	local lo = { math.huge, math.huge, math.huge }
	local hi = { -math.huge, -math.huge, -math.huge }
	for _, name in sh.meshes do
		local f = fit[name]
		if not f then
			return {}
		end
		for k = 1, 3 do
			lo[k] = math.min(lo[k], f.offset[k] - f.size[k] / 2)
			hi[k] = math.max(hi[k], f.offset[k] + f.size[k] / 2)
		end
	end
	local out: { Mesh } = {}
	for _, name in sh.meshes do
		local f = fit[name]
		local sz, off = {}, {}
		for k = 1, 3 do
			local span = math.max(hi[k] - lo[k], 1e-3)
			local scale = size[k] / span
			sz[k] = f.size[k] * scale
			off[k] = (f.offset[k] - (lo[k] + hi[k]) / 2) * scale
		end
		table.insert(out, {
			name = name,
			size = sz,
			offset = off,
			color = f.color,
			mat = f.mat or "SmoothPlastic",
			alpha = f.alpha or 0,
		})
	end
	return out
end

---------------------------------------------------------------------------
-- A whole HQ (the tests and the preview)
---------------------------------------------------------------------------

-- One side's HQ with everything shown (every station, 12 trophies, every prop, the top dressing tier, the five
-- head mounts, `statues` statues): `places` the placed looks (cell offsets) and `boxes` today's parts
-- ({ x, y, z, sx, sy, sz, art, name }, the middle in cell offsets; art = the placement hiding it). Turned
-- parts are listed by their box in the cell's frame (the wall's, the plaques' are axis-aligned there).
function HqArtKit.scene(
	Config: any,
	side: string?,
	statues: number?
): { places: { Place }, boxes: { any }, wall: { Place } }
	local places: { Place } = {}
	local boxes = {}
	local function box(name: string, x, y, z, sx, sy, sz, art: number?, extra: { [string]: any }?)
		local b = { name = name, x = x, y = y, z = z, sx = sx, sy = sy, sz = sz, art = art }
		for k, v in extra or {} do
			b[k] = v
		end
		table.insert(boxes, b)
	end
	-- stations: the pad look hides the pad, the console the post
	for name in Config.Hq.stations do
		local x, z = HqArtKit.stationAt(Config, name)
		local pad = SetPieceKit.place(places, HqArtKit.pad(side), x, 0, z, 0)
		box("pad", x, HqArtKit.PAD.y, z, 10, 0.4, 10, pad)
		local look = HqArtKit.station(side, name) :: string
		local k = SetPieceKit.place(places, look, x, 0, z, HqArtKit.FACING[name])
		local beside = if HqArtKit.BESIDE[name] then { beside = true } else nil
		box("post", x, HqArtKit.POST.y, z, 1.2, 3.2, 1.2, k, beside)
	end
	-- the trophy wall: the frame stands behind the plaques (it hides no part of today's); plaques and trophies
	local wall: { Place } = {}
	local bx, by, bz = HqArtKit.trophyBase(Config)
	SetPieceKit.place(wall, HqArtKit.trophyWall(side), bx, by, bz, 0)
	for i = 1, 12 do
		local x, y, z = HqArtKit.trophySpot(Config, i)
		local p = SetPieceKit.place(places, HqArtKit.plaque(side), x, y, z, 0)
		box("plaque", x, y, z, 3.6, 3, 0.4, p)
		local t = SetPieceKit.place(places, HqArtKit.trophy(i), x, y + 0.2, z - 0.6, 0)
		box("cup", x, y + 0.2, z - 0.6, 1.4, 1.2, 1.2, t, { shape = "Cylinder" })
	end
	-- statues' plinths
	local n = statues or 5
	for i = 1, n do
		local x, z, a = HqArtKit.statueAt(Config, i, n)
		local k = SetPieceKit.place(places, HqArtKit.plinth(side), x, 0, z, math.deg(a))
		box("plinth", x, 1, z, 5, 2, 5, k, { shape = "Cylinder" }) -- (turned: by its largest side)
	end
	-- props
	for bit, spot in HqArtKit.PROP_SPOTS do
		if HqArtKit.PART_PROPS[bit] then
			continue -- drawn from its own parts kit (the Lore Shelf), no mesh to place
		end
		local look = HqArtKit.PROPS[bit]
		local size, y, tilt = HqArtKit.propBox(bit)
		local ry = HqArtKit.facing(spot[1], spot[2])
		local k = SetPieceKit.place(places, look, spot[1], 0, spot[2], ry)
		box("prop", spot[1], y, spot[2], size[1], size[2], size[3], k, if tilt then { tilt = true } else nil)
	end
	-- the dressing at the top tier
	local pieces = RepTiers.dressing(Config, side, RepTiers.MAX)
	local dplaces, hides = HqArtKit.dressing(side, pieces)
	local base = #places
	for _, p in dplaces do
		table.insert(places, p)
	end
	for i, p in pieces do
		local a = hides[i]
		box(
			p.name,
			p.x,
			p.y,
			p.z,
			p.sx,
			p.sy,
			p.sz,
			if a then base + a else nil,
			if p.shape or p.ry or p.rz then { shape = p.shape or "Turned" } else nil
		)
	end
	-- WP9's wall: the board (and the poster's pins), five mounts and their plates
	local L = WantedRules.layout(Config)
	local yaw = HqArtKit.wallYaw(Config)
	local function wallPlace(look: string, s: any): number
		local x, y, z = WantedRules.toCell(Config, s.x, s.y, s.z)
		return SetPieceKit.place(places, look, x, y, z, yaw)
	end
	local function wallBox(name: string, s: any, art: number, extra: { [string]: any }?)
		local x, y, z = WantedRules.toCell(Config, s.x, s.y, s.z)
		-- the wall frame is turned a quarter: its x runs along the cell's z
		local q = math.abs(math.sin(math.rad(yaw))) > 0.5
		box(name, x, y, z, if q then s.sz else s.sx, s.sy, if q then s.sx else s.sz, art, extra)
	end
	local b = wallPlace(HqArtKit.board(side), L.board)
	wallBox("board", L.board, b)
	for _, pin in HqArtKit.pins(Config) do
		wallBox(
			"pin",
			{ x = pin[1], y = pin[2], z = pin[3], sx = 0.35, sy = 0.35, sz = 0.35 },
			b,
			{ shape = "Ball" }
		)
	end
	for r = 1, #L.mounts do
		local m = wallPlace(HqArtKit.mount(side), L.mounts[r])
		wallBox("mount", L.mounts[r], m)
		local pl = wallPlace(HqArtKit.NAMEPLATE, L.plates[r])
		wallBox("plate", L.plates[r], pl)
	end
	return { places = places, boxes = boxes, wall = wall }
end

-- Every look name used anywhere in the HQ (both sides): the fit table must hold each one, and nothing else
function HqArtKit.looks(Config: any): { [string]: boolean }
	local out: { [string]: boolean } = {}
	for _, side in { "hero", "villain" } do
		local s = HqArtKit.scene(Config, side, 5)
		for _, p in s.places do
			out[p.look] = true
		end
		for _, p in s.wall do
			out[p.look] = true
		end
	end
	for _, sh in HqArtKit.SHAPES do
		out[sh.look] = true
	end
	out[HqArtKit.BODY] = true
	return out
end

return HqArtKit

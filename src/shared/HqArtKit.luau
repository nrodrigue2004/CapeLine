function HqArtKit.station(side: string?, name: string): string?
	local s = HqArtKit.STATIONS[name]
	return if s then "Hq" .. s .. HqArtKit.tag(side) else nil
end

function HqArtKit.pad(side: string?): string
	return "HqPad" .. HqArtKit.tag(side)
end

-- A station's foot on the floor (cell offsets)
function HqArtKit.stationAt(Config: any, name: string): (number, number)
	local s = Config.Hq.stations[name]
	return s[1], s[2]
end

---------------------------------------------------------------------------
-- The Trophy Wall
---------------------------------------------------------------------------

HqArtKit.TROPHY_COLS = 4
HqArtKit.PLAQUE = { 3.6, 3, 0.4 }
HqArtKit.CUP = { 1.2, 1.4, 1.2 }
-- the three trophy shapes, by trophy (cup, star, medal in turn down Config.Hq.trophies)
HqArtKit.TROPHIES = { "HqTrophyCup", "HqTrophyStar", "HqTrophyMedal" }

-- The wall's foot: the middle of its plaque row, on the floor (cell offsets)
function HqArtKit.trophyBase(Config: any): (number, number, number)
	local x, z = HqArtKit.stationAt(Config, "trophies")
	return x, 0, z + 8
end

-- The middle of slot i's plaque (cell offsets): four to a row, rows upward
function HqArtKit.trophySpot(Config: any, i: number): (number, number, number)
	local bx, _, bz = HqArtKit.trophyBase(Config)
	local col, row = (i - 1) % HqArtKit.TROPHY_COLS, (i - 1) // HqArtKit.TROPHY_COLS
	return bx + (col - 1.5) * 4.2, 4 + row * 3.6, bz
end

function HqArtKit.trophyWall(side: string?): string
	return "HqTrophyWall" .. HqArtKit.tag(side)
end

function HqArtKit.plaque(side: string?): string
	return "HqPlaque" .. HqArtKit.tag(side)
end

function HqArtKit.trophy(idx: number): string
	return HqArtKit.TROPHIES[(idx - 1) % #HqArtKit.TROPHIES + 1]
end

---------------------------------------------------------------------------
-- The Hall of Legends' statues
---------------------------------------------------------------------------

HqArtKit.PLINTH = { size = { 5, 2, 5 }, y = 1 }

-- Statue i of n: its foot (cell offsets) and the way it faces (radians about up), in a half ring round the hall
function HqArtKit.statueAt(Config: any, i: number, n: number): (number, number, number)
	local hx, hz = HqArtKit.stationAt(Config, "legends")
	local a = math.rad(-80 + (i - 1) * (160 / math.max(1, math.min(n, 20) - 1)))
	return hx + math.sin(a) * 14, hz + math.cos(a) * 6 + 4, a + math.pi
end

function HqArtKit.plinth(side: string?): string
	return "HqPlinth" .. HqArtKit.tag(side)
end


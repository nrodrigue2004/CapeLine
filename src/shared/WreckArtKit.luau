--!strict
-- WreckArtKit: downed robots' wrecks in art/blender/wrecks.py's meshes (gap-wrecks, 2026-11-19; imported as
-- ReplicatedStorage.Art.Wrecks, each kind's look in Config.WreckArt, generated by the same script from the kind's
-- heap box, colours and gear). Pure, so Lune checks it.
-- * lookOf(kind): "Wreck" .. kind. ready(Config, kind, has): every mesh of that look found (a half import never shows
--   half a wreck); not ready: ThrowService builds today's plain heap.
-- * meshes(Config, kind, sx, sy, sz): the look's meshes (size and centre from the heap box's middle, unturned),
--   stretched to the box ThrowService builds now (the same box the look was built on, so a stretch of 1).
-- * check(Config, ThrowMath): every kind that leaves a wreck has a look built on its current heap box (a config
--   change shows here until the script runs again), with its dead eyes mesh, and no mesh reaches far past the heap.
-- The wreck's plain Body box stays its collider and the part a carry welds to (hidden once the look is drawn).

local DeepArtKit = if script then require(script.Parent.DeepArtKit) else (require :: any)("./DeepArtKit")

local WreckArtKit = {}

-- How far a mesh may reach past the heap box: this share of the box across, and of its height (an arm, a leg or
-- a cape spills a little; wrecks.py fits every heap inside)
WreckArtKit.REACH = 1.27
WreckArtKit.REACH_UP = 1.28

local function view(Config: any): any
	return { DeepArt = Config.WreckArt or {}, City = Config.City }
end

function WreckArtKit.lookOf(kind: string): string
	return "Wreck" .. kind
end

function WreckArtKit.ready(Config: any, kind: string, has: (string) -> boolean): boolean
	return DeepArtKit.ready(view(Config), WreckArtKit.lookOf(kind), has)
end

function WreckArtKit.meshes(
	Config: any,
	kind: string,
	sx: number,
	sy: number,
	sz: number
): { DeepArtKit.Mesh }
	return DeepArtKit.meshes(
		view(Config),
		{ look = WreckArtKit.lookOf(kind), cx = 0, cy = 0, cz = 0, sx = sx, sy = sy, sz = sz }
	)
end

-- Is this mesh a wreck's dead eyes (ThrowFx flickers them)?
function WreckArtKit.isEyes(name: string): boolean
	return string.sub(name, -4) == "Eyes"
end

-- Problems (empty when fine)
function WreckArtKit.check(Config: any, ThrowMath: any): { string }
	local bad = {}
	local seen: { [string]: boolean } = {}
	for kind, cfg in Config.Enemies do
		if type(cfg) ~= "table" or not cfg.body or not ThrowMath.canWreck(cfg) then
			continue
		end
		local look = WreckArtKit.lookOf(kind)
		seen[look] = true
		local fit = DeepArtKit.fit(view(Config), look)
		if not fit then
			table.insert(bad, kind .. ": no wreck look")
			continue
		end
		local sx, sy, sz = ThrowMath.wreckSize(Config.Throw, cfg)
		local box = { sx, sy, sz }
		for k = 1, 3 do
			if math.abs(fit.frame[k] - box[k]) > 0.01 then
				table.insert(
					bad,
					string.format(
						"%s: built on %.2f, the heap is %.2f (axis %d)",
						kind,
						fit.frame[k],
						box[k],
						k
					)
				)
			end
		end
		local eyes = false
		for _, m in WreckArtKit.meshes(Config, kind, sx, sy, sz) do
			eyes = eyes or WreckArtKit.isEyes(m.name)
			for k = 1, 3, 2 do
				local reach = math.abs(m.offset[k]) + m.size[k] / 2
				if reach > box[k] / 2 * WreckArtKit.REACH + 0.02 then
					table.insert(
						bad,
						string.format(
							"%s: %s reaches %.2f past its heap (axis %d)",
							kind,
							m.name,
							reach - box[k] / 2,
							k
						)
					)
				end
			end
			if m.offset[2] + m.size[2] / 2 > sy / 2 + sy * (WreckArtKit.REACH_UP - 1) + 0.02 then
				table.insert(bad, kind .. ": " .. m.name .. " stands too tall")
			end
			-- nothing sinks into the ground
			if m.offset[2] - m.size[2] / 2 < -sy / 2 - 0.05 then
				table.insert(bad, kind .. ": " .. m.name .. " sinks under the ground")
			end
		end
		if not eyes then
			table.insert(bad, kind .. ": no Eyes mesh")
		end
	end
	for look in Config.WreckArt or {} do
		if not seen[look] then
			table.insert(bad, look .. ": no robot kind leaves this wreck")
		end
	end
	return bad
end

return WreckArtKit

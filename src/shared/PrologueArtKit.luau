--!strict
-- PrologueArtKit: the Ceremony prologue's props dressed in Blender meshes (gap-prologue, 2026-11-19; the meshes are
-- art/blender/prologue.py's, uploaded and pulled into ReplicatedStorage.Art.Prologue; each mesh's size, centre,
-- colour and material is Config.PrologueArt, generated by the same script). Pure, so Lune checks it.
-- * Every look dresses one plain part PrologueFx already builds (its frame): the meshes sit at offsets from that
--   part's centre, in its own studs. A look is drawn only when every one of its meshes is found (ready), so a half
--   import never shows half a look; the plain parts it stands for are then hidden but kept exactly as they were:
--   the deck, the steps and the subway rubble still collide, take queries and stand where they stood. The meshes
--   never collide, take queries or touches. Nothing imported: every part shows as before (the fallback).
-- * FRAMES: the plain parts by name, their sizes from Config (the same numbers PrologueFx builds them with), so a
--   test sees a look still fits its part after a config change.
-- * meshes(Config, look): a look's meshes, sorted by name.
-- * check(Config): each look's meshes inside its frame (with the slack the look allows), no mesh colliding.

local PrologueArtKit = {}

export type Mesh = {
	name: string,
	size: { number },
	offset: { number },
	color: { number },
	mat: string,
	alpha: number,
	maps: boolean,
}

-- look -> the frame it dresses, the plain parts it hides, and how far its meshes may reach past the frame's box
-- (studs: x, up, z each way; dressing like the towers and barriers stands beside the deck, not on it)
PrologueArtKit.LOOKS = {
	Stage = { frame = "deck", hides = { "deck", "trim", "steps" }, reach = { 1, 3, 6 } },
	Podium = { frame = "deck", hides = { "podium" }, reach = { 0, 5, 0 } },
	Spotlights = { frame = "deck", hides = {}, reach = { 5, 21, 0 } },
	Barriers = { frame = "deck", hides = {}, reach = { 4, 0.5, 6.5 } },
	HallBanner = { frame = "banner", hides = {}, reach = { 4.5, 5, 0.4 } },
	Scanner = { frame = "scanner", hides = { "scanner", "scannerRing" }, reach = { 2.5, 0.8, 2.5 } },
	FallingSign = { frame = "sign", hides = { "sign" }, reach = { 0.1, 1.5, 0.3 } },
	Slab = { frame = "slab", hides = { "slab" }, reach = { 1, 0.6, 1 } },
	Rubble = { frame = "rubble", hides = { "slab" }, reach = { 0.2, 3.2, 0.2 } },
	Billboard = { frame = "board", hides = {}, reach = { 1.5, 7, 6 } },
} :: { [string]: { frame: string, hides: { string }, reach: { number } } }

-- Silas Crane on the billboard's catwalk (the ad leaves its left third for him; seen from the front, the picture's
-- left is the board's +x): his feet on the catwalk, from the board's centre in its studs, his size (RigMath scale)
-- and his turn toward the ad's words (degrees about up)
PrologueArtKit.CRANE = { at = { 22, -21.42, -3.05 }, scale = 5, yaw = 25 }

-- The plain parts' sizes (studs) and, for the ones on the deck's frame, their centres on it
function PrologueArtKit.frames(Config: any): { [string]: { size: { number }, at: { number }? } }
	local O = Config.Story.opening
	local P = O.plaza.stage
	local S = O.subway
	local B = O.billboard
	return {
		deck = { size = { P.width, P.height, P.depth } },
		trim = { size = { P.width + 0.6, 0.6, P.depth + 0.6 }, at = { 0, P.height / 2, 0 } },
		steps = { size = { 10, P.height / 2, 4 }, at = { 0, -P.height / 4, -P.depth / 2 - 2 } },
		podium = { size = { 3, 4, 2 }, at = { 0, P.height, -0.5 } },
		banner = { size = { P.width, 16, 1 } },
		scanner = { size = { 4, 4, 4 } },
		scannerRing = { size = { 7, 0.4, 7 } },
		sign = { size = { 8, 3, 1 } },
		slab = { size = { S.width - 1, 3, S.slab } },
		rubble = { size = { S.width - 1, S.rubble, S.slab } },
		board = { size = { B.size[1], B.size[2], 1 } },
	}
end

-- A look's fit table (mesh name -> size, offset, colour, material), or nil
function PrologueArtKit.fit(Config: any, look: string): { [string]: any }?
	local a = Config.PrologueArt and Config.PrologueArt[look]
	return if type(a) == "table" then a else nil
end

-- Is every mesh of this look found?
function PrologueArtKit.ready(Config: any, look: string, has: (string) -> boolean): boolean
	local fit = PrologueArtKit.fit(Config, look)
	if fit == nil or next(fit) == nil then
		return false
	end
	for name in fit do
		if not has(name) then
			return false
		end
	end
	return true
end

-- A look's meshes, sorted by name (offsets from its frame's centre)
function PrologueArtKit.meshes(Config: any, look: string): { Mesh }
	local out: { Mesh } = {}
	for name, f in PrologueArtKit.fit(Config, look) or {} do
		table.insert(out, {
			name = name,
			size = f.size,
			offset = f.offset,
			color = f.color,
			mat = f.mat or "SmoothPlastic",
			alpha = f.alpha or 0,
			maps = f.maps == true,
		})
	end
	table.sort(out, function(a, b)
		return a.name < b.name
	end)
	return out
end

-- The box round a look's meshes, in its frame's studs: lo, hi
function PrologueArtKit.bounds(Config: any, look: string): ({ number }, { number })
	local lo = { math.huge, math.huge, math.huge }
	local hi = { -math.huge, -math.huge, -math.huge }
	for _, m in PrologueArtKit.meshes(Config, look) do
		for k = 1, 3 do
			lo[k] = math.min(lo[k], m.offset[k] - m.size[k] / 2)
			hi[k] = math.max(hi[k], m.offset[k] + m.size[k] / 2)
		end
	end
	return lo, hi
end

-- Problems (empty when fine): every look known and fitted, its meshes within its frame's box plus its reach, and
-- the hidden parts known
function PrologueArtKit.check(Config: any): { string }
	local bad = {}
	local frames = PrologueArtKit.frames(Config)
	for look, row in PrologueArtKit.LOOKS do
		local f = frames[row.frame]
		if not f then
			table.insert(bad, look .. ": unknown frame " .. row.frame)
			continue
		end
		for _, h in row.hides do
			if not frames[h] then
				table.insert(bad, look .. ": hides an unknown part " .. h)
			end
		end
		if PrologueArtKit.fit(Config, look) == nil then
			table.insert(bad, look .. ": no fit table")
			continue
		end
		local lo, hi = PrologueArtKit.bounds(Config, look)
		for k = 1, 3 do
			local half = f.size[k] / 2
			if lo[k] < -half - row.reach[k] - 0.05 or hi[k] > half + row.reach[k] + 0.05 then
				table.insert(
					bad,
					string.format(
						"%s: reaches past its %s (axis %d: %.2f..%.2f, box %.2f)",
						look,
						row.frame,
						k,
						lo[k],
						hi[k],
						half
					)
				)
			end
		end
	end
	for look in Config.PrologueArt or {} do
		if not PrologueArtKit.LOOKS[look] then
			table.insert(bad, look .. ": in Config.PrologueArt but no look")
		end
	end
	return bad
end

return PrologueArtKit

--!strict
-- DeepArtKit: the underwater areas dressed in art/blender/deep.py's meshes (the deep art pass, 2026-11-19; imported
-- as ReplicatedStorage.Art.Deep, each look's frame and meshes in Config.DeepArt, generated by the same script). Pure,
-- so Lune checks it.
-- * Shared.DeepLayout lists placements (layout.art): a look stretched to fill its own box { cx, cy, cz, sx, sy, sz,
--   ry } (the look's frame scaled per axis), `tint` a City.palette colour for the meshes that take it (coral, kelp).
--   A box a look stands in for carries `art` = that look's name.
-- * readyLooks(Config, has): the looks whose every mesh is found (has(name)), so a half import never shows half a
--   look. A box of a ready look is hidden but kept (hides): it still collides, takes queries and makes the walls
--   robots and heroes use exactly as before; the meshes never collide. Nothing found: every box shows as today.
-- * meshes(Config, place): one placement's meshes (size and offset from the placement's middle, before its turn;
--   colour, material, transparency, maps), placed by CityBuilder.
-- * check(Config, layout): every look known, every hidden box inside its look's placements, the looks not
--   stretched out of shape and their meshes inside their boxes (dressing may reach `slack` studs past).
-- * sway(Config, t, x, z): a kelp strand's lean (radians about x and z) at time t, the same on every device.

local DeepArtKit = {}

export type Mesh = {
	name: string,
	size: { number },
	offset: { number },
	color: { number },
	mat: string,
	alpha: number,
	maps: boolean,
}

-- A look's fit table ({ frame, meshes }), or nil
function DeepArtKit.fit(Config: any, look: string): any?
	local a = Config.DeepArt and Config.DeepArt[look]
	return if type(a) == "table" and type(a.meshes) == "table" then a else nil
end

-- Is every mesh of this look found?
function DeepArtKit.ready(Config: any, look: string, has: (string) -> boolean): boolean
	local fit = DeepArtKit.fit(Config, look)
	if fit == nil or next(fit.meshes) == nil then
		return false
	end
	for name in fit.meshes do
		if not has(name) then
			return false
		end
	end
	return true
end

-- The looks drawn as meshes: look -> true (empty before the import)
function DeepArtKit.readyLooks(Config: any, has: (string) -> boolean): { [string]: boolean }
	local out = {}
	for look in Config.DeepArt or {} do
		if DeepArtKit.ready(Config, look, has) then
			out[look] = true
		end
	end
	return out
end

-- Is this box hidden behind its look's meshes?
function DeepArtKit.hides(box: any, ready: { [string]: boolean }): boolean
	local a = box.art
	return type(a) == "string" and ready[a] == true
end

-- The stretch of a placement: its box over the look's frame, per axis
function DeepArtKit.scale(Config: any, place: any): (number, number, number)
	local fit = DeepArtKit.fit(Config, place.look)
	if not fit then
		return 1, 1, 1
	end
	local f = fit.frame
	return place.sx / f[1], place.sy / f[2], place.sz / f[3]
end

-- One placement's meshes, sorted by name (offsets from the placement's middle, before its turn)
function DeepArtKit.meshes(Config: any, place: any): { Mesh }
	local out: { Mesh } = {}
	local fit = DeepArtKit.fit(Config, place.look)
	if fit == nil then
		return out
	end
	local kx, ky, kz = DeepArtKit.scale(Config, place)
	local tint = place.tint and Config.City.palette[place.tint]
	for name, m in fit.meshes do
		table.insert(out, {
			name = name,
			size = { m.size[1] * kx, m.size[2] * ky, m.size[3] * kz },
			offset = { m.offset[1] * kx, m.offset[2] * ky, m.offset[3] * kz },
			color = if m.tint and tint then tint else m.color,
			mat = m.mat or "SmoothPlastic",
			alpha = m.alpha or 0,
			maps = m.maps == true,
		})
	end
	table.sort(out, function(a, b)
		return a.name < b.name
	end)
	return out
end

-- A point in a placement's turned box (with `pad` studs to spare)?
local function inside(place: any, x: number, y: number, z: number, pad: number): boolean
	local a = math.rad(place.ry or 0)
	local c, s = math.cos(a), math.sin(a)
	local dx, dz = x - place.cx, z - place.cz
	-- into the placement's own axes (Roblox's turn about up: world = (lx c + lz s, -lx s + lz c))
	local lx = dx * c - dz * s
	local lz = dx * s + dz * c
	return math.abs(lx) <= place.sx / 2 + pad
		and math.abs(y - place.cy) <= place.sy / 2 + pad
		and math.abs(lz) <= place.sz / 2 + pad
end
DeepArtKit.inside = inside

-- A box's corners in world studs (a ball or an upright cylinder by its round size)
function DeepArtKit.corners(b: any): { { number } }
	local hx, hy, hz = b.sx / 2, b.sy / 2, b.sz / 2
	if b.shape == "ball" then
		-- a ball by its six round points (it turns with no corners)
		local m = math.max(b.sx, b.sy, b.sz) / 2
		return {
			{ b.cx + m, b.cy, b.cz },
			{ b.cx - m, b.cy, b.cz },
			{ b.cx, b.cy + m, b.cz },
			{ b.cx, b.cy - m, b.cz },
			{ b.cx, b.cy, b.cz + m },
			{ b.cx, b.cy, b.cz - m },
		}
	elseif b.shape == "cylinder" then
		-- an upright cylinder by eight points round its top and bottom rims (it turns with no corners)
		local r = math.min(b.sx, b.sz) / 2
		local out = {}
		for k = 0, 7 do
			local a = k * math.pi / 4
			for dy = -1, 1, 2 do
				table.insert(out, { b.cx + math.cos(a) * r, b.cy + dy * hy, b.cz + math.sin(a) * r })
			end
		end
		return out
	end
	local a = math.rad(b.ry or 0)
	local c, s = math.cos(a), math.sin(a)
	local out = {}
	for dx = -1, 1, 2 do
		for dy = -1, 1, 2 do
			for dz = -1, 1, 2 do
				local lx, lz = dx * hx, dz * hz
				table.insert(out, { b.cx + lx * c + lz * s, b.cy + dy * hy, b.cz - lx * s + lz * c })
			end
		end
	end
	return out
end

-- Problems with the Deep's looks (empty when fine)
function DeepArtKit.check(Config: any, layout: any, slack: number?): { string }
	local bad = {}
	local pad = slack or 2.5
	local byLook: { [string]: { any } } = {}
	for i, p in layout.art do
		local name = string.format("place %d %s", i, tostring(p.look))
		local fit = DeepArtKit.fit(Config, p.look)
		if not fit then
			table.insert(bad, name .. ": unknown look")
			continue
		end
		byLook[p.look] = byLook[p.look] or {}
		table.insert(byLook[p.look], p)
		local kx, ky, kz = DeepArtKit.scale(Config, p)
		-- (tall looks may stretch up: kelp, tubes and fans grow to their box's height)
		if kx < 0.5 or kx > 2 or kz < 0.5 or kz > 2 or ky < 0.4 or ky > 3 then
			table.insert(bad, string.format("%s: stretched %.2f x %.2f x %.2f", name, kx, ky, kz))
		end
		if p.tint and not Config.City.palette[p.tint] then
			table.insert(bad, name .. ": no palette colour " .. tostring(p.tint))
		end
		for _, m in DeepArtKit.meshes(Config, p) do
			for k, s in { p.sx, p.sy, p.sz } do
				if math.abs(m.offset[k]) + m.size[k] / 2 > s / 2 + pad then
					table.insert(bad, string.format("%s: %s reaches past its box (axis %d)", name, m.name, k))
				end
			end
		end
	end
	local covered: { [any]: boolean } = {}
	for i, b in layout.boxes do
		local look = b.art
		if look == nil then
			continue
		end
		local list = byLook[look]
		if type(look) ~= "string" or not DeepArtKit.fit(Config, look) or not list then
			table.insert(bad, string.format("box %d: no look %s", i, tostring(look)))
			continue
		end
		for _, q in DeepArtKit.corners(b) do
			local hit = false
			for _, p in list do
				if inside(p, q[1], q[2], q[3], 0.05) then
					hit = true
					covered[p] = true
				end
			end
			if not hit then
				table.insert(bad, string.format("box %d (%s): a corner outside every %s", i, b.kind, look))
				break
			end
		end
	end
	-- (a placement stands in for a box when it holds one of the box's corners, or their bounds overlap: a
	-- segment in the middle of a long wall)
	local function aabb(q: any): ({ number }, { number })
		local lo, hi = { math.huge, math.huge, math.huge }, { -math.huge, -math.huge, -math.huge }
		for _, c in DeepArtKit.corners(q) do
			for k = 1, 3 do
				lo[k], hi[k] = math.min(lo[k], c[k]), math.max(hi[k], c[k])
			end
		end
		return lo, hi
	end
	for _, b in layout.boxes do
		local blo, bhi = aabb(b)
		local list: { any } = if type(b.art) == "string" then byLook[b.art] or {} else {}
		for _, p in list do
			if not covered[p] then
				local plo, phi = aabb(p)
				local over = true
				for k = 1, 3 do
					over = over and math.min(bhi[k], phi[k]) - math.max(blo[k], plo[k]) > 0.1
				end
				covered[p] = over
			end
		end
	end
	for i, p in layout.art do
		if DeepArtKit.fit(Config, p.look) and not covered[p] then
			table.insert(bad, string.format("place %d %s: stands in for no box", i, p.look))
		end
	end
	return bad
end

-- How much the Deep draws once every look is in: meshes and triangles
function DeepArtKit.budget(Config: any, layout: any): (number, number)
	local n, tris = 0, 0
	for _, p in layout.art do
		local fit = DeepArtKit.fit(Config, p.look)
		for _, m in if fit then fit.meshes else {} do
			n += 1
			tris += m.tris or 0
		end
	end
	return n, tris
end

-- A kelp strand's lean about x and z (radians) at time t: a slow sway with its own phase from where it stands
function DeepArtKit.sway(Config: any, t: number, x: number, z: number): (number, number)
	local k = Config.Deep.art.kelp
	local ph = (x * 0.137 + z * 0.071) % (math.pi * 2)
	local amp = math.rad(k.angle)
	local w = k.speed
	return amp * math.sin(t * w + ph), amp * 0.6 * math.sin(t * w * 0.73 + ph * 1.7)
end

-- The kelp this preset sways: within `near` studs of the camera, at most `max` strands
function DeepArtKit.swayBudget(Config: any, preset: string): (number, number)
	local k = Config.Deep.art.kelp[preset] or Config.Deep.art.kelp.low
	return k.near, k.max
end

return DeepArtKit

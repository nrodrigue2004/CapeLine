-- The boss pass (2026-11-19): the world bosses and the War-Frame animated from their mesh segments (Shared.BossPose,
-- Fx.BossAnim), comic telegraphs (Fx.BossTelegraph), the Tidal surge wave and the Blackout's eyes (Fx.EventFx).
-- Server truth is unchanged: the pose module never touches a hit, a shape or a time. ONLY="Boss anim" runs these.
-- Called from tests/run.luau.

return function(T: any)
	local test, check, Config = T.test, T.check, T.Config
	local fs = require("@lune/fs")
	local BossPose = require("../src/shared/BossPose")
	local B, A = Config.Boss, Config.BossArt

	local function src(path: string): string
		return fs.readFile(path)
	end

	local function rigOf(id: string): { [string]: boolean }
		local out = { Root = true }
		for _, r in A[id].rig do
			out[r.name] = true
		end
		return out
	end

	local function eachPose(set: any, fn: (where: string, pose: any) -> ())
		for name, c in set.clips do
			for i, k in c.keys do
				fn(name .. " key " .. i, k.pose)
			end
		end
		for id, a in set.attacks do
			for i, k in a.windup.keys do
				fn(id .. " wind-up key " .. i, k.pose)
			end
			for i, k in a.recover.keys do
				fn(id .. " recover key " .. i, k.pose)
			end
		end
	end

	test("Boss anim: every boss's rig and clip set is complete", function()
		local n = 0
		for id, def in B.bosses do
			local set = BossPose.SETS[id]
			check(set ~= nil, id .. " has a pose set")
			if not set then
				continue
			end
			n += 1
			local rig = rigOf(id)
			-- the pose set's segments are exactly the meshes' rig (BossArt rig, generated by art/blender/bosses.py)
			local count = 0
			for _, seg in set.segments do
				check(rig[seg] == true, id .. ": segment " .. seg .. " is in BossArt's rig")
				count += 1
			end
			local rigCount = 0
			for _ in rig do
				rigCount += 1
			end
			check(
				count == rigCount,
				id .. ": every rig segment is posed (" .. count .. " of " .. rigCount .. ")"
			)
			for _, name in BossPose.REQUIRED do
				check(set.clips[name] ~= nil, id .. " has a " .. name .. " clip")
			end
			if def.speed > 0 then
				check(set.clips.walk ~= nil and set.clips.walk.loop == true, id .. " walks (it moves)")
			end
			check(set.clips.idle.loop == true, id .. "'s idle loops")
			for _, loopName in { "idle", "walk" } do
				local c = set.clips[loopName]
				if c then
					local a, z = BossPose.sample(c, 0), BossPose.sample(c, c.dur)
					for seg, v in a do
						for k = 1, 6 do
							check(
								math.abs(v[k] - ((z[seg] or {})[k] or 0)) < 1e-6,
								id .. " " .. loopName .. " loops seamlessly"
							)
						end
					end
				end
			end
			-- one clip per attack, no strays
			local want = {}
			for _, atk in def.attacks do
				want[atk.id] = true
				check(set.attacks[atk.id] ~= nil, id .. " animates " .. atk.id)
			end
			for aid in set.attacks do
				check(want[aid] == true, id .. ": " .. aid .. " is a real attack")
			end
			-- every posed segment is in the rig; the spinning machinery is in the rig and never posed
			eachPose(set, function(where, pose)
				for seg in pose do
					check(rig[seg] == true, id .. " " .. where .. ": " .. seg .. " is a segment")
					check(
						not (set.spin and set.spin[seg]),
						id .. " " .. where .. ": " .. seg .. " only spins"
					)
				end
			end)
			for seg, s in set.spin or {} do
				check(rig[seg] == true, id .. ": spinning " .. seg .. " is in the rig")
				check(
					(s.axis == "x" or s.axis == "y" or s.axis == "z") and s.rate ~= 0,
					id .. " " .. seg .. " spins"
				)
			end
			-- the defeat holds its collapsed pose; every other one-shot ends at rest
			for name, c in set.clips do
				if not c.loop and name ~= "defeat" then
					local last = c.keys[#c.keys]
					check(next(last.pose) == nil and last.t == c.dur, id .. " " .. name .. " ends at rest")
				end
			end
		end
		check(n == 7, "all seven bosses are animated (" .. n .. ")") -- bosses-3: the Storm Colossus, Swarm Queen and Quarry Titan
	end)

	test("Boss anim: every attack's wind-up ends exactly at its hit time", function()
		for id, def in B.bosses do
			local set = BossPose.SETS[id]
			for _, atk in def.attacks do
				local a = set and set.attacks[atk.id]
				if not a then
					continue
				end
				local keys = a.windup.keys
				check(
					keys[1].t == 0 and next(keys[1].pose) == nil,
					id .. " " .. atk.id .. " winds up from rest"
				)
				local last = keys[#keys]
				check(
					last.t == 1 and last.hit == true,
					id .. " " .. atk.id .. ": the strike is the wind-up's last key"
				)
				local peaks = 0
				for i = 2, #keys do
					check(keys[i].t > keys[i - 1].t, id .. " " .. atk.id .. " keys in order")
					if keys[i].peak then
						peaks += 1
						check(
							keys[i].t >= 0.5 and keys[i].t < 1,
							id .. " " .. atk.id .. ": the anticipation peaks late"
						)
					end
				end
				check(peaks == 1, id .. " " .. atk.id .. " has one anticipation peak")
				-- in seconds: the hit is BossSim's resolve time (the warning), the anticipation reads (0.5 s or more)
				local tm = BossPose.timing(id, atk.id, atk.warn)
				check(
					tm ~= nil and math.abs(tm.hit - atk.warn) < 1e-9,
					id .. " " .. atk.id .. " hits at " .. atk.warn .. " s"
				)
				check(
					tm ~= nil and tm.peak >= 0.5,
					id .. " " .. atk.id .. " shows its wind-up for 0.5 s or more"
				)
				local before, stage1 = BossPose.attack(id, atk.id, atk.warn - 0.002, atk.warn)
				local at, stage2 = BossPose.attack(id, atk.id, atk.warn, atk.warn)
				check(
					stage1 == "windup" and stage2 == "recover",
					id .. " " .. atk.id .. ": wind-up, then recover at the hit"
				)
				-- at the hit the pose is the strike, and just before it is nearly there (the strike lands, no pop)
				for seg, v in last.pose do
					for k = 1, 6 do
						check(
							math.abs(((at or {})[seg] or {})[k] - v[k]) < 1e-6,
							id .. " " .. atk.id .. " strikes at the hit"
						)
						check(
							math.abs((((before or {})[seg] or {})[k] or 0) - v[k]) < 6,
							id .. " " .. atk.id .. " no pop"
						)
					end
				end
				local rk = a.recover.keys
				check(
					rk[1].t == 0 and rk[1].pose == last.pose,
					id .. " " .. atk.id .. " recovers from the strike"
				)
				check(next(rk[#rk].pose) == nil, id .. " " .. atk.id .. " recovers to rest")
				-- the recover is over before the next attack can start (the phase's gap after the hit)
				for _, ph in atk.phases do
					check(
						a.recover.dur <= def.gap[ph],
						id .. " " .. atk.id .. " recovers inside phase " .. ph .. "'s gap"
					)
				end
				check(
					BossPose.attack(id, atk.id, atk.warn + a.recover.dur + 0.01, atk.warn) == nil,
					id .. " " .. atk.id .. " ends"
				)
			end
		end
	end)

	test("Boss anim: every pose stays inside its joint limits (idle on top)", function()
		for id, set in BossPose.SETS do
			local lim = BossPose.LIMITS[id]
			check(lim ~= nil, id .. " has joint limits")
			if not lim then
				continue
			end
			-- the idle at its biggest (phase 3 scale) rides under every other clip
			local idleMax: { [string]: { number } } = {}
			local s3 = BossPose.idleScale[3]
			for _, k in set.clips.idle.keys do
				for seg, v in k.pose do
					local m = idleMax[seg] or { 0, 0, 0, 0 }
					for i = 1, 3 do
						m[i] = math.max(m[i], math.abs(v[i]) * s3)
					end
					m[4] = math.max(m[4], math.sqrt(v[4] ^ 2 + v[5] ^ 2 + v[6] ^ 2) * s3)
					idleMax[seg] = m
				end
			end
			eachPose(set, function(where, pose)
				for seg, v in pose do
					local l = lim[seg]
					check(l ~= nil, id .. " " .. where .. ": " .. seg .. " has limits")
					if not l then
						continue
					end
					local base = idleMax[seg] or { 0, 0, 0, 0 }
					for i = 1, 3 do
						check(
							math.abs(v[i]) + base[i] <= l[i] + 1e-6,
							string.format(
								"%s %s: %s axis %d %.1f within %d",
								id,
								where,
								seg,
								i,
								math.abs(v[i]) + base[i],
								l[i]
							)
						)
					end
					local mv = math.sqrt(v[4] ^ 2 + v[5] ^ 2 + v[6] ^ 2) + base[4]
					check(
						mv <= l[4] + 1e-6,
						string.format("%s %s: %s moves %.1f within %d", id, where, seg, mv, l[4])
					)
				end
			end)
		end
	end)

	test("Boss anim: BossArt's segments, rig and part-built looks agree", function()
		for id in B.bosses do
			local art = A[id]
			local rig = rigOf(id)
			local seen = { Root = true }
			for _, r in art.rig do
				check(seen[r.parent] == true, id .. ": " .. r.name .. "'s parent comes first")
				seen[r.name] = true
				check(#r.pivot == 3, id .. ": " .. r.name .. " has a pivot")
				check(
					math.abs(r.pivot[1]) <= 60 and r.pivot[2] >= -60,
					id .. ": " .. r.name .. "'s pivot is on the body"
				)
			end
			check(rig.Body == true, id .. " has a Body segment")
			for name, row in art.pieces do
				check(rig[row.seg] == true, id .. "_" .. name .. " moves with a real segment")
				local want = if row.seg == "Body" then nil else row.seg .. "_"
				check(
					want == nil or string.sub(name, 1, #want) == want,
					id .. "_" .. name .. " is named for its segment"
				)
			end
			for i, row in art.parts or {} do
				check(rig[row.seg] == true, id .. " part " .. i .. " moves with a real segment")
			end
		end
		-- the segments split the old roles, never add any: still one hull per segment at most, the same roles
		local s = 0
		for name, row in A.RustjawPrime.pieces do
			if row.role == "hull" then
				s += 1
			end
			check(name ~= "", "named")
		end
		check(s >= 8, "Rustjaw's hull is split into its limbs (" .. s .. " hull pieces)")
	end)

	test("Boss anim: sampling, mirroring and the machinery", function()
		local c = BossPose.SETS.RustjawPrime.clips.flinch
		local mid = BossPose.sample(c, 0.12)
		check(mid.Body ~= nil and math.abs(mid.Body[1] - 8) < 1e-6, "sample hits a key exactly")
		local m = BossPose.mirror({ ArmL = { 1, 2, 3, 4, 5, 6 } })
		check(m.ArmR ~= nil and m.ArmR[2] == -2 and m.ArmR[3] == -3 and m.ArmR[4] == -4, "mirror swaps sides")
		local sum = BossPose.add({ Body = { 1, 0, 0, 0, 0, 0 } }, { Body = { 2, 0, 0, 0, 0, 0 } }, 0.5)
		check(sum.Body[1] == 2, "add weights")
		check(BossPose.spinScale(3, true) > BossPose.spinScale(1, false), "the machinery races in a wind-up")
		check(
			BossPose.bigHit(5000, 100000) and not BossPose.bigHit(1000, 100000),
			"big hits flinch, small ones not"
		)
		check(BossPose.attack("RustjawPrime", "Nope", 0, 1) == nil, "an unknown attack has no pose")
	end)

	test("Boss anim: the client draws it cheaply and keeps the rules", function()
		local anim = src("src/client/Fx/BossAnim.luau")
		local tele = src("src/client/Fx/BossTelegraph.luau")
		local ev = src("src/client/Fx/EventFx.luau")
		local wf = src("src/client/Fx/WorldFx.luau")
		check(string.find(anim, "BulkMoveTo", 1, true) ~= nil, "BossAnim moves every piece in one bulk call")
		check(
			string.find(anim, "QualityController", 1, true) ~= nil,
			"BossAnim's rate follows the device preset"
		)
		check(string.find(wf, 'FrameProf.wrap("WorldFx"', 1, true) ~= nil, "the boss frame loop is profiled")
		check(string.find(ev, "FrameProf", 1, true) ~= nil, "the event looks' loop is profiled")
		for name, text in { BossTelegraph = tele, EventFx = ev } do
			check(string.find(text, "reduceFlashing", 1, true) ~= nil, name .. " respects Reduce flashing")
			check(string.find(text, "QualityController", 1, true) ~= nil, name .. " scales with the preset")
		end
		check(string.find(tele, "FxLib", 1, true) ~= nil, "telegraphs use the effects library's particles")
		-- server truth unchanged: no client file sends anything about bosses back
		for _, text in { anim, tele, ev } do
			check(
				string.find(text, "Net.fire", 1, true) == nil
					and string.find(text, "Net.send", 1, true) == nil,
				"draw only"
			)
		end
		check(
			string.find(src("src/shared/BossSim.luau"), "BossPose", 1, true) == nil,
			"BossSim does not depend on the poses"
		)
	end)
end
